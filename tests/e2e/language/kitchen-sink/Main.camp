// ============================================================
// SECTION: P2 Standard Library — Base64
// Demonstrates: Base64/Base32/Hex encoding and decoding
// ============================================================

// import Base64 { [Base64Format, Base64Err], encode, decode, encode64, decode64, encode16, decode16 }
//
// encode : Base64Format, Bytes -> Str               -- parameterized by format
// decode : Base64Format, Str -> Result(Bytes, Base64Err)
// encode_str : Base64Format, Str -> Str             -- UTF-8 convenience
// decode_str : Base64Format, Str -> Result(Str, Base64Err)
//
// Shorthands:
// encode64 / decode64                              -- Standard Base64 (A-Za-z0-9+/)
// encode64url / decode64url                         -- URL-safe Base64 (A-Za-z0-9-_)
