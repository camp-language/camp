// ============================================================
// SECTION: P3 Standard Library — Map & Set
// Demonstrates: Map(k, v) ordered tree map, Set(a) ordered set,
//   Ord trait dispatch for key comparison
// ============================================================

import Map { new, insert, get, contains, remove, size, is_empty, keys, values, fold, from_list, to_list, union, intersection, difference }
import Set { new, insert, contains, remove, size, is_empty, union, intersection, difference, symmetric_difference, is_subset, is_disjoint, fold, from_list, to_list }

-- Map construction and access
m = Map.new
assert_eq Map.is_empty(m), True
assert_eq Map.size(m), 0
m2 = Map.insert("hello", 1, m)
assert_eq Map.contains("hello", m2), True
assert_eq Map.get("hello", m2), Ok(1)
assert_eq Map.size(m2), 1
m3 = Map.remove("hello", m2)
assert_eq Map.size(m3), 0

-- Map fold
m4 = Map.from_list([("a", 1), ("b", 2), ("c", 3)])
assert_eq Map.fold(m4, 0, |acc, _, v| acc + v), 6

-- Set construction and access
s = Set.new
assert_eq Set.is_empty(s), True
assert_eq Set.size(s), 0
s2 = Set.insert(42, s)
assert_eq Set.contains(42, s2), True
assert_eq Set.size(s2), 1
s3 = Set.remove(42, s2)
assert_eq Set.size(s3), 0

-- Set fold
s4 = Set.from_list([1, 2, 3, 4, 5])
assert_eq Set.fold(s4, 0, |acc, x| acc + x), 15

-- Set operations
s5 = Set.from_list([1, 2, 3])
s6 = Set.from_list([3, 4, 5])
assert_eq Set.size(Set.union(s5, s6)), 5
assert_eq Set.size(Set.intersection(s5, s6)), 1
assert_eq Set.is_disjoint(Set.from_list([1, 2]), Set.from_list([3, 4])), True
assert_eq Set.is_subset(Set.from_list([1, 2]), Set.from_list([1, 2, 3])), True

// ============================================================
// ============================================================
// SECTION: Eq Trait
// Demonstrates: == and != operators, Eq conformance
// ============================================================
// Eq tests: primitives handled by WASM scalar comparison
// Structural type Eq uses auto-derived functions
//
// I64 eq
// F64 eq - NaN
// Bool eq
// Str eq
// Record eq
// Tag union eq
// Tuple eq
//
// Not Eq types: function values cannot be compared
// == and != require both operands to have the same type
// Result of ==/!= is always Bool
// Note: primitive ==/!= handled as WASM ops
// Structural ==/!= calls auto-derived eq function

// ============================================================
// SECTION: main! Entry Point
// Demonstrates: pub, effect row as handler declaration,
//   Termination trait for return type
// ============================================================

pub main! = || -[Console! | Throw!([..])]-> I64 {
  primitives_demo()
}

// main! returns any type implementing Termination trait:
// I64 -> exit code, {} -> exit 0, Result(a, e) -> Ok=0 / Err=1
// Throw!([..]) means "can throw any error type" (open tag union)

// ============================================================
// SECTION: IntoIter / FromIter Traits
// Demonstrates: trait with type params, is-blocks on generic types,
//   into_iter for List/Map/Set/Str/Bytes/Result,
//   from_iter for List/Map/Set/Str/Bytes,
//   collect pattern via FromIter
// ============================================================

// List into_iter / from_iter:
// xs = [1, 2, 3]
// xs.to_iter()                          -- yields Iter(I64)
// Iter.from_list([1,2,3])->List.from_iter()  -- collect into List

// Map into_iter: yields (k, v) pairs
// Map.singleton("a", 1)->Map.to_iter()

// Result into_iter: 0 or 1 elements
// Ok(42).to_iter()                      -- yields [42] via Iter
// Err("x").to_iter()                    -- yields [] via Iter

// Str into_iter: grapheme-by-grapheme
// "hello".to_iter()                     -- yields ["h","e","l","l","o"]

// Bytes into_iter:
// Bytes.singleton(0xFF).to_iter()       -- yields [255]

