// kitchen-sink/Main.camp
// The living example of every Camp language feature.
// This file MUST compile and pass as the compiler implements each feature.
// When adding a language feature, update this file to exercise it.
// See AGENTS.md for the maintenance contract.

// ============================================================
// SECTION: Comments
// Demonstrates: // line comments, /// doc comments
// ============================================================

// This is a single-line comment.
/// This is a doc comment (CommonMark, doctest runner).
/// Doc comments go before declarations they document.

// ============================================================
// SECTION: Primitive Types
// Demonstrates: I8, I16, I32, I64, U8, U16, U32, U64, F32, F64,
//   Bool, Char, Str, {} (unit)
// Integer literal default: I64. Float literal default: F64.
// Explicit type annotation on binding.
// ============================================================

primitives_demo = || -> I64 {
  i8_val: I8 = 127
  i16_val: I16 = 32767
  i32_val: I32 = 2147483647
  i64_val: I64 = 42
  u8_val: U8 = 255
  u16_val: U16 = 65535
  u32_val: U32 = 4294967295
  u64_val: U64 = 100
  f32_val: F32 = 3.0
  f64_val: F64 = 2.718281828
  bool_val: Bool = True
  char_val: Char = 'a'
  unit_val: {} = {}
  i64_val
}

// ============================================================
// SECTION: Char Literals
// Demonstrates: 'a' syntax, Char type
// ============================================================

// 'x'             -- a single character
// '\n'            -- escape sequences work
// '\u{1F600}'     -- unicode escapes
// char_val: Char = 'a'

// ============================================================
// SECTION: Strings & Interpolation
// Demonstrates: "text" literals, ${expr} interpolation, Display
//   trait, \ per-line prefix for multiline/raw strings
// ============================================================

// "Hello, World!"                    -- plain string literal
// "Hello, ${name}!"                  -- interpolated (Display required)
// "${x + y} items"                   -- expression in interpolation hole
// "\${literal}"                      -- escaped ${ produces literal ${
//
// \Line 1                            -- per-line prefix (multiline, raw)
// \Line 2                            -- no escapes, ${} still active
// \${value}!                         -- interpolation in per-line strings
//
// Display trait: Str, I64, I32, F64, Bool implement Display
// Non-Display types in ${} are compile errors

// ============================================================
// SECTION: Numeric Literals
// Demonstrates: hex, octal, binary, underscore separators
// ============================================================

// 0xFF              -- hex
// 0o77              -- octal
// 0b1010            -- binary
// 1_000_000         -- underscore separator
// 3.14              -- float
// 1.0e10            -- scientific notation

// ============================================================
// SECTION: Tag Unions (Structural, Roc-style)
// Demonstrates: tags with/without payload, closed/open/fully-open
//   union types, variant set inference, case-based disambiguation
// ============================================================

// Tag construction: bare UpperCamelCase, no # prefix
// Ok(42)            -- with payload
// Err("fail")       -- with payload
// None              -- empty tag (NO parens)
// True              -- boolean tag
//
// Closed tag union type: [Ok(a) | Err(e)]
// Open tag union type: [Ok(a) | Err(e) | ..rest]
// Fully open tag union type: [..]

// ============================================================
// SECTION: Nominal Types
// Demonstrates: @ prefix on declaration only, construction with @,
//   destruction in patterns with @, pub variants, parameterized,
//   is/derives clauses, method block
// ============================================================

// @UserId : U64                              -- simple nominal type
// @UserId is Eq : U64                        -- with trait conformance
// @UserId is Ord derives Eq, Hash : U64      -- is before derives
//
// @Result(a, e) : [Ok(a) | Err(e)]          -- parameterized, wrapping tag union
// @Result(a, e) : pub [Ok(a) | Err(e)]      -- pub exposes variants
//
// @User : { name: Str, age: U64 }            -- wrapping a record
//
// @Counter : U64 {                           -- nominal with method block
//   increment = |self: Self| -> Self { @Counter(self + 1) }
// }
//
// Construction: @UserId(42)
// Destruction: match uid { @UserId(n) => n }
// Type annotation: x : UserId (NOT x : @UserId)
// Self available in method blocks, refers to the nominal type

// ============================================================
// SECTION: Type Aliases (Transparent)
// Demonstrates: : syntax, no @ prefix, structural unification,
//   no derives, no method block
// ============================================================

// IntList : List(I64)                 -- simple alias
// Coords : { x: F64, y: F64 }        -- record alias
// Maybe(a) : [Just(a) | Nothing]     -- parameterized tag union alias
//
// No derives on type aliases (derives is only on nominal types)
// No method block on type aliases

// ============================================================
// SECTION: Records (Structural, Row-Polymorphic)
// Demonstrates: construction, field access, functional update,
//   row polymorphism, open/closed, spread syntax
// ============================================================

// { name: Str, age: U64 }           -- closed type
// { name: Str, .. }                 -- open type
// { name: Str, ..rest }             -- open with row variable
// { name: "Camp", age: 1 }         -- construction
// { ..record, name: "new" }         -- record spread (update, not merge)
// { name, age } = record            -- closed destructuring
// { name, .. } = record             -- open destructuring
// record.name                        -- field access
//
// Row polymorphism: greet = |person: { name: Str, .. }| -> Str { ... }
// Spread at end only: { x: 1, y: 2, ..rest }

// ============================================================
// SECTION: Functions
// Demonstrates: |args| body syntax, named/anonymous, block bodies,
//   ! suffix for effectful, generic type params, where clause
// ============================================================

add_one = |x: I64| -> I64 { x + 1 }

// Multi-param lambda
add = |x, y| x + y

// Anonymous lambda: |x| x + 1
// Effectful function: read_line! = || -[Console!]-> Str { ... }
// Generic: add = |x: a, y: a| -> a where a is Add { x + y }
// where clause: |items| where a is Ord { ... }

// ============================================================
// SECTION: Effectful Function Naming
// Demonstrates: ! suffix on effectful names, enforced by compiler
// ============================================================

// A function with non-empty effect row MUST have ! in its name
// A function named without ! MUST have empty effect row
// Effect type names also end with !: Console!, Throw!, Async!

// ============================================================
// SECTION: Logic Operators
// Demonstrates: and/or/not keywords, no && || !
// ============================================================

logic_demo = || -> I64 {
  t: Bool = True and True
  f: Bool = True and False
  o: Bool = False or True
  n: Bool = not False
  // not binds tighter than and/or: not a and b = (not a) and b
  match t and o {
    True => 1
    False => 0
  }
}

// ============================================================
// SECTION: Mutable Variables
// Demonstrates: $ prefix at declaration and every use site,
//   stack-local only, no shadowing across scopes
// ============================================================

// $total = 0          -- mutable binding
// $total = $total + 1 -- reassignment (always with $)
// $ prefix banned on immutable bindings
// No $ at top level (module scope is always immutable)

// ============================================================
// SECTION: Dot Lambdas
// Demonstrates: .field, .method(args), .->func(), .(field)(),
//   effect row propagation
// ============================================================

// .name             desugars to |a| a.name
// .foo(x)           desugars to |a| a.foo(x)     (nominal dispatch)
// .->func(x)        desugars to |a| a->func(x)   (lexical UFCS)
// .(field)(x)       desugars to |a| a.(field)(x) (structural dispatch)
// .read!()          desugars to |a| a.read!()    (effectful)
// .. is spread, not double dot lambda

// ============================================================
// SECTION: UFCS (Uniform Function Call Syntax)
// Demonstrates: -> lexical UFCS, .(field)() structural dispatch,
//   .method() nominal dispatch, Trait.func() qualified dispatch
// ============================================================

// obj->func(args)     -- lexical UFCS (scope provides the function)
// obj.(field)(args)   -- structural dispatch (field stores the function)
// obj.method(args)    -- nominal dispatch (trait/inherent method)
// Trait.func(obj)     -- qualified trait dispatch (disambiguation)
//
// -> is postfix, same precedence as ., left-to-right, chainable:
// x->func()->method()

// ============================================================
// SECTION: Traits
// Demonstrates: record alias for pure functions, Self in trait
//   definitions, separate is blocks, strict orphan rule
// ============================================================

// Eq : { eq: |Self, Self| -> Bool }
// Ord : { compare: |Self, Self| -> Order }
// Hash : { hash: |Self| -> U64 }
//
// Self in trait definitions refers to the implementing type
// No associated types, no default implementations, no HKT
// Derivable built-in traits: Eq, Ord, Hash, Debug
// Trait implementations are separate is blocks:
//
// Color is Eq {
//   eq = |a: Self, b: Self| -> Bool {
//     match [a, b] {
//       [Red, Red] => True
//       [Green, Green] => True
//       _ => False
//     }
//   }
// }
//
// Strict orphan rule: type must be local to the module
// is blocks are pub by default

// ============================================================
// SECTION: Standalone is Blocks
// Demonstrates: Type is Trait { methods } syntax
// ============================================================

// Color is Eq {
//   eq = |a: Self, b: Self| -> Bool {
//     match [a, b] {
//       [Red, Red] => True
//       [Green, Green] => True
//       _ => False
//     }
//   }
// }
//
// One trait per block
// Self available in is blocks, refers to the nominal type being implemented
// Must be in same module as the nominal type definition

// ============================================================
// SECTION: Effect Rows
// Demonstrates: -[E1 | E2]-> syntax, row variables,
//   effect polymorphism, composition
// ============================================================

// a -> b                      -- pure (empty row, elided)
// a -[Console!]-> b            -- effectful
// a -[e]-> b                   -- row variable (polymorphic)
// a -[Throw!([..])]-> b        -- parameterized effect
// a -[Console! | ..effs]-> b   -- row variable at end
//
// |a| -[]-> I64                -- COMPILE ERROR: use -> instead
// Row properties: sets (order insignificant, dedup)
// Composition: g(f(x)) composes rows
// Polymorphism: map = |f: |a| -[e]-> b, ...| -[e]-> ... where a, b, e

// ============================================================
// SECTION: Effect Handlers
// Demonstrates: deep handlers only, one-shot resume,
//   multiple effects per handle block, handler arms
// ============================================================

// Deep handler (re-installed after each resume):
// handle Console! in { ... } with {
//   .println!(resume, msg) => { ... ; resume({}) }
// }
//
// Multiple effects per handle block:
// handle Console!, Throw! in body with {
//   .println!(resume, msg) => { ... ; resume({}) }
//   .raise!(resume, err) => { ... }
// }
//
// Single effect per block also valid:
// handle Console! in body with { ... }
//
// Resume: one-shot (0 or 1 times). 0 = abort, 1 = continue.
// Runtime error on double-resume.
// Intercept keyword removed -- deep handlers only.

// ============================================================
// SECTION: Throw! Effect
// Demonstrates: Throw! as prelude effect, raise! operation,
//   tag union widening, handler bridging Throw -> tag union
// ============================================================

// Throw!(e) : { raise!: |e| -> a }
// Throw!([NotFound])                           -- closed
// Throw!([NotFound | PermissionDenied])        -- closed, widened
// Throw!([NotFound | ..])                      -- open
// Throw!([..])                                 -- fully open (main!)
//
// Bridge: to_result = |action: || -[Throw!(e)]-> a| -> [Ok(a) | Err(e)] {
//   handle Throw! in { Ok(action()) } with {
//     .raise!(resume, err) => Err(err)
//   }
// }
//
// raise! never returns (inferred bottom type)
// Invocation: Throw.raise!(NotFound) (module-qualified, NOT Throw!.raise!())

// ============================================================
// SECTION: Effect Safety
// Demonstrates: unhandled effects = compile-time error,
//   main! effect row as handler declaration
// ============================================================

// main! = || -[Console! | Throw!([..])]-> I64 { ... }
// Runtime provides handlers for effects in main!'s row

// ============================================================
// SECTION: Effect Definitions & Aliases
// Demonstrates: type alias with ! suffix, operation names with !,
//   tag-union-like effect aliases, module-qualified invocation
// ============================================================

// Console! : {
//   println!: |Str| -> {}
//   read_line!: || -[Console!]-> Str
// }
//
// Invocation: Console.println!("hello")     -- module-qualified
// Invocation: Console.read_line!()          -- NOT Console!.println!()
//
// Effect alias (tag-union-like syntax with ! suffix):
// Io!: [File! | Console!]

// ============================================================
// SECTION: Pattern Matching
// Demonstrates: tag, record, list, tuple, literal, or-patterns,
//   guards, wildcard, as-patterns, string interpolation patterns,
//   exhaustiveness, no commas between arms
// ============================================================

// match result {
//   Ok(value) => value
//   Err(msg) => handle_error(msg)
// }
//
// match status {
//   s if s < 200 => "informational"
//   200 => "ok"
//   _ => "other"
// }
//
// match m {
//   Get | Head | Options => True
//   _ => False
// }
//
// match input {
//   "Hello, ${name}!" => name                -- string interpolation pattern
//   "${greeting}, ${target}!" => Str.concat(g, t) -- multiple bindings
//   _ => "unknown"
// }
//
// Some(x) as pair => pair                   -- as-pattern
// Red | Green | Blue => "primary"           -- or-pattern
// [a, b, ...rest] => rest                   -- list pattern with rest
// { name, age } => name                     -- record pattern
// (a, b) => a + b                           -- tuple pattern
//
// No commas between arms (newline separated)
// | for or-patterns within a single arm
// => (FatArrow) for arm body

// ============================================================
// SECTION: Type Annotations
// Demonstrates: name: Type = value, never separate declaration
// ============================================================

// x: Int = 3
// name: Str = "Camp"
// Annotation before =, consistent with all other : annotations

// ============================================================
// SECTION: No Shadowing
// Demonstrates: all shadowing forbidden, fresh names required
// ============================================================

// x = 1; x = 2             -- ERROR: same-scope rebinding
// x = 1; if True { x = 2 } -- ERROR: nested-scope shadowing
// Name must be unique within its scope

// ============================================================
// SECTION: Visibility
// Demonstrates: pub marks exports, everything else private
// ============================================================

// pub greet = |name| "Hello, ${name}!"
// helper = |x| x + 1  -- private, not accessible from other modules
// pub on type: exports the type name
// pub on variant body: all variants public or none

// ============================================================
// SECTION: Raw Identifiers
// Demonstrates: backtick-wrapped identifiers escape keywords
// ============================================================

// `do` = 42
// `is` = "keyword as name"
// r#type rejected -- only backtick style

// ============================================================
// SECTION: Self Scope
// Demonstrates: Self in trait definitions, is blocks, method blocks;
//   NOT available in free functions
// ============================================================

// Self in trait definitions   --> refers to implementing type
// Self in is blocks           --> refers to nominal type being implemented
// Self in method blocks       --> refers to nominal type
// Self in free functions      --> compile error

// ============================================================
// SECTION: par Blocks
// Demonstrates: par { name: expr, ... } named record entries,
//   par for loop, fail-fast semantics
// ============================================================

// par { x: compute_alpha!(), y: compute_beta!() }  -- record with named entries
// par for r in records { process_record!(r) }       -- parallel for loop
//
// par { x: e1, y: e2 }  returns { x: T1, y: T2 }   -- record type
// par for returns {} (unit, like regular for)
// Named entries only: par { name: expr, ... }
// Fail-fast: if any branch crashes, whole par block crashes

// ============================================================
// SECTION: Prelude Effects
// Demonstrates: Console!, Throw!, Parallel!, Spawn!, Async!
//   Module-qualified invocation (NOT effect-name-qualified)
// ============================================================

// Console.println!("hello")
// Console.read_line!()
// Throw.raise!(NotFound)
// Parallel.map!(...)
// Spawn.spawn!(|| { ... })
// Async.yield!()
//
// All effect operations: Module.op!() -- NOT Module!.op!()

// ============================================================
// SECTION: Dual Error Model
// Demonstrates: Throw! for exceptional, tag union for structural
//   No ? operator
// ============================================================

// Exceptional: Throw.raise!(NotFound) -- propagates via effect system
// Structural: match List.first(list) { Some(a) => a, None => fallback }
// No ? operator -- Throw propagates via effect rows

// ============================================================
// SECTION: Consistent .. Syntax
// Demonstrates: "and possibly more" across all contexts
// ============================================================

// { name: Str, .. }        -- open record type
// [Ok(a) | ..]             -- open tag union type
// { name, .. } = record    -- open destructuring
// { ..record, name: "new" } -- record update (spread)
// Throw!([..])             -- can throw any tag
// [a, b, ...rest]          -- list spread (multiple allowed in constructor)
// [a, ..] = list           -- list pattern rest (one per pattern)

// ============================================================
// SECTION: return / crash / todo
// Demonstrates: control flow keywords with inferred bottom type
// ============================================================

// return expr        -- exits function only. Expression with bottom type.
// crash "msg"        -- unrecoverable abort. Expression with bottom type.
// todo               -- placeholder, panics at runtime in debug
// todo "msg"         -- placeholder with message

// ============================================================
// SECTION: Test Declarations
// Demonstrates: test "name" { body } block syntax
// ============================================================

// test "addition works" {
//   expect add_one(40) == 41
// }
//
// test "primitives return 42" {
//   expect primitives_demo() == 42
// }
//
// Block syntax (not = body)
// Run via camp test

// ============================================================
// SECTION: Expect Declarations
// Demonstrates: expect condition, expect a == b desugaring
// ============================================================

// expect condition
// expect a == b     -- desugars to capture both operands + Debug
// /// Doc comment above expect shown on failure
//
// Non-equality expects show "evaluated to False"

// ============================================================
// SECTION: Import Syntax
// Demonstrates: qualified, unqualified, alias, variant grouping
// ============================================================

// import Module                          -- qualified only: Module.func()
// import Module { foo, bar }             -- unqualified + qualified
// import Module as M { foo, bar }        -- alias + unqualified
// import Result { [Ok, Err], map }       -- [brackets] for nominal type variants
//
// No exposing keyword -- names in { } directly
// No wildcard imports (always explicit)
// [Ok, Err] brackets for variant imports (comma-separated inside)
// No @ prefix in imports
// No re-exports (every name has one canonical home)
// Circular imports: banned (compile error)

// ============================================================
// SECTION: List Literals & Spread
// Demonstrates: [1, 2, 3] construction, multiple ..spread
// ============================================================

// [1, 2, 3]                         -- list literal
// [1, 2, ...rest, 5]               -- multiple spread elements allowed
// [1, 2, 3] = list                  -- list destructuring
// [a, b, ...rest] = list            -- list destructuring with rest
//
// Multiple ..spread allowed in construction (not in patterns)

// ============================================================
// SECTION: Tuple Types (Capped at 3)
// Demonstrates: (T1, T2), (T1, T2, T3), destructuring only
// ============================================================

// (42, "hello")                    -- tuple construction
// (1, 2, 3)                       -- max 3 elements
// (a, b) = pair                   -- destructuring (no .0 access)
// (a, b, c) = triple
//
// No tuple types with 4+ elements -- use records instead
// No .0, .1 field access (use destructuring or records)

// ============================================================
// SECTION: If/Else
// Demonstrates: braces always required, if/else as expression
// ============================================================

// if cond { ... }
// if cond { ... } else { ... }
// if cond { ... } else if cond2 { ... } else { ... }
//
// Braces always required (no brace elision)
// If/else is an expression -- both branches must produce the same type

// ============================================================
// SECTION: For Loop
// Demonstrates: for x in xs { body }, .iter(), immutable loop var
// ============================================================

// for x in xs { process(x) }            -- calls .iter() on xs
// $total = 0; for x in xs { $total = $total + x }    -- accumulator
// Returns {} (unit)

// ============================================================
// SECTION: Destructuring
// Demonstrates: record, list, tuple, nominal type destructuring
// ============================================================

// { name, age } = person            -- record destructuring
// [a, b, ...rest] = list            -- list destructuring
// (a, b) = tuple                    -- tuple destructuring
// @UserId(n) = uid                  -- nominal type destructuring (@ prefix)

// ============================================================
// SECTION: Built-in Derivable Traits
// Demonstrates: Eq, Ord, Hash, Debug
// ============================================================

// derives Eq, Ord, Hash, Debug
// Available only on nominal types (not type aliases)
// Display is NOT derivable (must be implemented manually)
// User-defined traits require manual is blocks
