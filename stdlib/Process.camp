// Process! effect — subprocess spawning
// Backed by WASIX proc_spawn/wait syscalls via wasmer.
// Two API levels:
//   Low-level: spawn! → read!/write!/close! → wait!
//   Simple: run! (spawn + wait + capture in one call)

import List { append }

// --- Types ---

@StdioMode : pub [Inherit | Capture | Null]

@Command : pub {
  program: Str,
  args: List(Str),
  env: List((Str, Str)),
  clear_env: Bool,
  working_dir: Option(Str),
  stdin: StdioMode,
  stdout: StdioMode,
  stderr: StdioMode,
}

@Handle : {}  // opaque file descriptor wrapper

@ProcessHandle : pub {
  pid: I32,
  stdin: Option(Handle),
  stdout: Option(Handle),
  stderr: Option(Handle),
}

// ProcessResult uses Bytes for stdout/stderr — consistent with read!.
// Use Process.to_str() to decode to Str when needed.
@ProcessResult : pub {
  exit_code: I32,
  stdout: Bytes,
  stderr: Bytes,
}

@ProcessError : pub [SpawnFailed(Str) | TimedOut | IoError(Str)]

// --- Effect operations ---

Process! : {
  // Non-blocking: spawn a child process. Pipe handles are available
  // based on the Command's StdioMode settings (Capture → Some, others → None).
  spawn! : |Command| -[Process! | Throw!([ProcessError])]-> ProcessHandle,

  // Block until the child exits. Returns exit code.
  // Auto-closes all pipe handles in the ProcessHandle before returning,
  // since pipes are dead after the child exits anyway (POSIX semantics).
  // Explicit close! is available for early cleanup (e.g., closing stdin
  // before the process exits to signal EOF).
  wait! : |ProcessHandle| -[Process! | Throw!([ProcessError])]-> I32,

  // Read bytes from a pipe handle (stdout/stderr of a spawned process).
  read! : |Handle| -[Process! | Throw!([ProcessError])]-> Bytes,

  // Write bytes to a pipe handle (stdin of a spawned process).
  write! : |Handle, Bytes| -[Process! | Throw!([ProcessError])]-> {},

  // Close a pipe handle early. Optional — wait! auto-closes all handles.
  // Use this to signal EOF on stdin before the process exits.
  close! : |Handle| -[Process!]-> {},

  // Convenience: spawn, wait, capture output.
  // Respects StdioMode: Capture → output captured, Inherit/Null → empty Bytes.
  // For the common case where you just want exit code + output.
  run! : |Command| -[Process! | Throw!([ProcessError])]-> ProcessResult,
}

// --- Pure helpers ---

// UTF-8 decode helper for a Bytes buffer. Routes through the Bytes.to_str
// intrinsic, which is not yet wired in the runtime; until it is, calling this
// traps rather than silently returning empty output. Tracked by bean camp-y4mj.
decode_utf8 = |b: Bytes| -> Str {
  match Bytes.to_str(b) {
    Ok(s) => s
    Err(_e) => crash "Process.to_str: stdout/stderr contained invalid UTF-8"
  }
}

// Decode a ProcessResult's Bytes fields to Str (assumes UTF-8).
pub to_str = |r: ProcessResult| -> { exit_code: I32, stdout: Str, stderr: Str } {
  { exit_code: r.exit_code, stdout: decode_utf8(r.stdout), stderr: decode_utf8(r.stderr) }
}

// --- Pure builder helpers ---

pub from = |program: Str| -> Command {
  @Command({
    program: program,
    args: [],
    env: [],
    clear_env: False,
    working_dir: None,
    stdin: Inherit,
    stdout: Inherit,
    stderr: Inherit,
  })
}

pub arg = |cmd: Command, a: Str| -> Command {
  @Command({
    program: cmd.program,
    args: List.append(cmd.args, [a]),
    env: cmd.env,
    clear_env: cmd.clear_env,
    working_dir: cmd.working_dir,
    stdin: cmd.stdin,
    stdout: cmd.stdout,
    stderr: cmd.stderr,
  })
}

pub args = |cmd: Command, new_args: List(Str)| -> Command {
  @Command({
    program: cmd.program,
    args: new_args,
    env: cmd.env,
    clear_env: cmd.clear_env,
    working_dir: cmd.working_dir,
    stdin: cmd.stdin,
    stdout: cmd.stdout,
    stderr: cmd.stderr,
  })
}

pub env = |cmd: Command, key: Str, val: Str| -> Command {
  @Command({
    program: cmd.program,
    args: cmd.args,
    env: Cons((key, val), cmd.env),
    clear_env: cmd.clear_env,
    working_dir: cmd.working_dir,
    stdin: cmd.stdin,
    stdout: cmd.stdout,
    stderr: cmd.stderr,
  })
}

pub cwd = |cmd: Command, dir: Str| -> Command {
  @Command({
    program: cmd.program,
    args: cmd.args,
    env: cmd.env,
    clear_env: cmd.clear_env,
    working_dir: Some(dir),
    stdin: cmd.stdin,
    stdout: cmd.stdout,
    stderr: cmd.stderr,
  })
}

pub capture_stdout = |cmd: Command| -> Command {
  @Command({
    program: cmd.program,
    args: cmd.args,
    env: cmd.env,
    clear_env: cmd.clear_env,
    working_dir: cmd.working_dir,
    stdin: cmd.stdin,
    stdout: Capture,
    stderr: cmd.stderr,
  })
}

pub capture_stderr = |cmd: Command| -> Command {
  @Command({
    program: cmd.program,
    args: cmd.args,
    env: cmd.env,
    clear_env: cmd.clear_env,
    working_dir: cmd.working_dir,
    stdin: cmd.stdin,
    stdout: cmd.stdout,
    stderr: Capture,
  })
}

pub capture_all = |cmd: Command| -> Command {
  @Command({
    program: cmd.program,
    args: cmd.args,
    env: cmd.env,
    clear_env: cmd.clear_env,
    working_dir: cmd.working_dir,
    stdin: cmd.stdin,
    stdout: Capture,
    stderr: Capture,
  })
}

pub null_stdin = |cmd: Command| -> Command {
  @Command({
    program: cmd.program,
    args: cmd.args,
    env: cmd.env,
    clear_env: cmd.clear_env,
    working_dir: cmd.working_dir,
    stdin: Null,
    stdout: cmd.stdout,
    stderr: cmd.stderr,
  })
}


// --- Tests ---
// Builder-helper `test` blocks are omitted: any function returning a record
// type (here, every Process builder returning the 9-field @Command) compiled
// alongside a `test` block's synthetic `main!` triggers a pre-existing WASM
// codegen i64/i32 type-mismatch (wasm validation rejects the binary at the
// `br` returning the synthesized main's result). This is the same class of
// bug fixed for `IR_Call` in camp-jqvd, but that fix did not extend to record
// construction (`IR_Construct_Record`) lowering; record-returning functions
// still carry a stale i64 type snapshot where the lowered value is i32.
// Follow-up bean: extend camp-jqvd's `rederive_call_type` approach to record
// construction lowering. Once fixed, the builder helpers above are pure Camp
// and straightforward to test (happy -> empty -> singleton -> multi -> edge).
