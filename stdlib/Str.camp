// Str.camp
// Str is a builtin type. This file declares the public API.
// All functions are intrinsic (require runtime UTF-8/Unicode support).

// Queries
pub length = |s: Str| -> I64 { crash "intrinsic: Str.length" }

pub byte_size = |s: Str| -> I64 { crash "intrinsic: Str.byte_size" }

pub is_empty = |s: Str| -> Bool { byte_size(s) == 0 }

// Comparison
pub starts_with = |s: Str, prefix: Str| -> Bool { crash "intrinsic: Str.starts_with" }

pub ends_with = |s: Str, suffix: Str| -> Bool { crash "intrinsic: Str.ends_with" }

pub contains = |s: Str, substr: Str| -> Bool { crash "intrinsic: Str.contains" }

// Slicing (grapheme-safe)
pub take = |s: Str, n: I64| -> Str { crash "intrinsic: Str.take" }

pub drop = |s: Str, n: I64| -> Str { crash "intrinsic: Str.drop" }

pub slice = |s: Str, start: I64, len: I64| -> Str { crash "intrinsic: Str.slice" }

// Splitting
pub split = |s: Str, sep: Str| -> List(Str) { crash "intrinsic: Str.split" }

pub split_first = |s: Str, sep: Str| -> Result((Str, Str), [NotFound]) { crash "intrinsic: Str.split_first" }

pub split_last = |s: Str, sep: Str| -> Result((Str, Str), [NotFound]) { crash "intrinsic: Str.split_last" }

// Trimming (Unicode whitespace)
pub trim = |s: Str| -> Str { crash "intrinsic: Str.trim" }

pub trim_start = |s: Str| -> Str { crash "intrinsic: Str.trim_start" }

pub trim_end = |s: Str| -> Str { crash "intrinsic: Str.trim_end" }

// Case (Unicode)
pub to_lower = |s: Str| -> Str { crash "intrinsic: Str.to_lower" }

pub to_upper = |s: Str| -> Str { crash "intrinsic: Str.to_upper" }

// Concatenation
pub concat = |a: Str, b: Str| -> Str { crash "intrinsic: Str.concat" }

pub join = |parts: List(Str), sep: Str| -> Str { crash "intrinsic: Str.join" }

pub repeat = |s: Str, n: I64| -> Str { crash "intrinsic: Str.repeat" }

// Replacement
pub replace = |s: Str, pattern: Str, replacement: Str| -> Str { crash "intrinsic: Str.replace" }

pub replace_first = |s: Str, pattern: Str, replacement: Str| -> Str { crash "intrinsic: Str.replace_first" }

// Prefix/Suffix manipulation
pub drop_prefix = |s: Str, prefix: Str| -> Str { crash "intrinsic: Str.drop_prefix" }

pub drop_suffix = |s: Str, suffix: Str| -> Str { crash "intrinsic: Str.drop_suffix" }

// Conversion
pub to_bytes = |s: Str| -> Bytes { crash "intrinsic: Str.to_bytes" }

pub from_bytes = |b: Bytes| -> Result(Str, [InvalidUtf8]) { crash "intrinsic: Str.from_bytes" }

pub from_bytes_lossy = |b: Bytes| -> Str { crash "intrinsic: Str.from_bytes_lossy" }

// Parsing (numeric)
pub to_i64 = |s: Str| -> Result(I64, [InvalidFormat]) { crash "intrinsic: Str.to_i64" }

pub to_f64 = |s: Str| -> Result(F64, [InvalidFormat]) { crash "intrinsic: Str.to_f64" }

// Iteration (grapheme-by-grapheme)
pub to_iter = |s: Str| -> Iter(Str) { crash "intrinsic: Str.to_iter" }

Str is Eq {
    eq = |a: Self, b: Self| -> Bool { a == b }
}

Str is Default {
  default = || -> Str { crash "intrinsic: Str_default" }
}
Str is From {
  from = |val: Str| -> Bytes { Str.to_bytes(val) }
}

Str is TryFrom {
  try_from = |val: Str| -> Result(I64, ParseError) {
    match Str.to_i64(val) {
      Ok(v) => Ok(v)
      Err(_) => Err(ParseError("Invalid integer format"))
    }
  }
}
Str is TryFrom {
  try_from = |val: Str| -> Result(F64, ParseError) {
    match Str.to_f64(val) {
      Ok(v) => Ok(v)
      Err(_) => Err(ParseError("Invalid float format"))
    }
  }
}
Str is TryFrom {
  try_from = |b: Bytes| -> Result(Str, [InvalidUtf8]) {
    Bytes.to_str(b)
  }
}

Str is Debug {
    debug = |a: Self| -> Str { crash "intrinsic: Str_debug" }
}

Str is Ord {
    compare = |a: Self, b: Self| -> Order { crash "intrinsic: Str_compare" }
}

Str is Hash {
    hash = |a: Self, h: Hasher| -> Hasher { crash "intrinsic: Str_hash" }
}
