// Bool.camp
// @Bool: pub [True | False]  // declared by compiler

pub not_ = |b: Bool| -> Bool {
  match b {
    True => False
    False => True
  }
}

pub xor_ = |a: Bool, b: Bool| -> Bool {
  match a {
    True => not_(b)
    False => b
  }
}

pub and_ = |a: Bool, b: Bool| -> Bool {
  match a {
    True => b
    False => False
  }
}

pub or_ = |a: Bool, b: Bool| -> Bool {
  match a {
    True => True
    False => b
  }
}

Bool is Eq {
    eq = |a: Self, b: Self| -> Bool { crash "intrinsic: Bool_eq" }
}
Bool is Default {
  default = || -> Bool { False }
}
Bool is From {
  from = |val: Bool| -> I8 { crash "intrinsic: Bool_to_I8" }
}
Bool is From {
  from = |val: Bool| -> I16 { crash "intrinsic: Bool_to_I16" }
}
Bool is From {
  from = |val: Bool| -> I32 { crash "intrinsic: Bool_to_I32" }
}
Bool is From {
  from = |val: Bool| -> I64 { crash "intrinsic: Bool_to_I64" }
}
Bool is From {
  from = |val: Bool| -> U8 { crash "intrinsic: Bool_to_U8" }
}
Bool is From {
  from = |val: Bool| -> U16 { crash "intrinsic: Bool_to_U16" }
}
Bool is From {
  from = |val: Bool| -> U32 { crash "intrinsic: Bool_to_U32" }
}
Bool is From {
  from = |val: Bool| -> U64 { crash "intrinsic: Bool_to_U64" }
}
Bool is From {
  from = |val: Bool| -> F32 { crash "intrinsic: Bool_to_F32" }
}
Bool is From {
  from = |val: Bool| -> F64 { crash "intrinsic: Bool_to_F64" }
}


Bool is Debug {
    debug = |a: Self| -> Str { crash "intrinsic: Bool_debug" }
}

Bool is Ord {
    compare = |a: Self, b: Self| -> Order {
        if a < b { Less } else if a == b { Equal } else { Greater }
    }
}
Bool is Hash {
    hash = |a: Self, h: Hasher| -> Hasher { crash "intrinsic: Bool_hash" }
}
// Tests
test "Bool traits" {
  expect not_(True) == False
  expect not_(False) == True
  expect and_(True, True) == True
  expect and_(True, False) == False
  expect and_(False, True) == False
  expect and_(False, False) == False
  expect or_(True, True) == True
  expect or_(True, False) == True
  expect or_(False, True) == True
  expect or_(False, False) == False
  expect xor_(True, True) == False
  expect xor_(True, False) == True
  expect xor_(False, True) == True
  expect xor_(False, False) == False
  expect False < True
  expect not (True < False)
  expect True > False
  expect False <= False
  expect True >= True
}
