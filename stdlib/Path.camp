-- @Path — opaque filesystem path, normalized on construction
-- Per D25: Opaque type, auto-normalized. No I/O on Path — that's in File!.

@Path : -- opaque, provided by runtime

-- Construction

/// Create a Path from a string, normalizing the path on construction.
///
/// ```
/// new("foo/bar")       -> Path("foo/bar")
/// new("foo//bar")      -> Path("foo/bar")       -- collapses duplicate slashes
/// new("foo/./bar")     -> Path("foo/bar")       -- removes dot segments
/// ```
pub new : Str -> Path
pub new = |s| crash "intrinsic: Path.new"

/// Join two paths, returning a new normalized path.
///
/// ```
/// join(new("foo/bar"), new("baz"))  -> Path("foo/bar/baz")
/// join(new("foo/"), new("/bar"))    -> Path("foo/bar")  -- collapses leading slash
/// ```
pub join : Path, Path -> Path
pub join = |a, b| crash "intrinsic: Path.join"

/// Construct a path from a list of path segments, joining them with the OS separator.
///
/// ```
/// from_list(["foo", "bar", "baz"])  -> Path("foo/bar/baz")
/// from_list(["..", "foo"])          -> Path("../foo")
/// ```
pub from_list : List(Str) -> Path
pub from_list = |parts| crash "intrinsic: Path.from_list"

-- Decomposition

/// Return the parent directory of a path.
///
/// ```
/// parent(new("foo/bar/file.txt"))  -> Ok(Path("foo/bar"))
/// parent(new("file.txt"))         -> Err(HasNoParent)
/// ```
pub parent : Path -> Result(Path, [HasNoParent])
pub parent = |p| crash "intrinsic: Path.parent"

/// Return the filename (final component) of a path.
///
/// ```
/// filename(new("foo/bar/file.txt"))  -> "file.txt"
/// filename(new("foo/bar"))           -> "bar"
/// ```
pub filename : Path -> Str
pub filename = |p| crash "intrinsic: Path.filename"

/// Return the stem (filename without extension) of a path.
///
/// ```
/// stem(new("foo/bar/file.txt"))  -> "file"
/// stem(new("foo/bar/README"))    -> "README"
/// ```
pub stem : Path -> Str
pub stem = |p| crash "intrinsic: Path.stem"

/// Return the extension (including the leading dot) of a path.
///
/// ```
/// extension(new("foo/bar/file.txt"))  -> ".txt"
/// extension(new("foo/bar/README"))    -> ""
/// ```
pub extension : Path -> Str
pub extension = |p| crash "intrinsic: Path.extension"

-- Manipulation

/// Replace the extension of a path with a new one (including the dot).
///
/// ```
/// with_extension(new("foo/bar/file.txt"), ".md")  -> Path("foo/bar/file.md")
/// with_extension(new("foo/bar/file.txt"), "")      -> Path("foo/bar/file")
/// ```
pub with_extension : Path, Str -> Path
pub with_extension = |p, ext| crash "intrinsic: Path.with_extension"

/// Replace the filename of a path with a new one.
///
/// ```
/// with_filename(new("foo/bar/file.txt"), "new.txt")  -> Path("foo/bar/new.txt")
/// ```
pub with_filename : Path, Str -> Path
pub with_filename = |p, name| crash "intrinsic: Path.with_filename"

/// Replace the parent directory of a path with a new one.
///
/// ```
/// with_parent(new("foo/bar/file.txt"), new("baz"))  -> Path("baz/file.txt")
/// ```
pub with_parent : Path, Path -> Path
pub with_parent = |p, parent| crash "intrinsic: Path.with_parent"

-- Queries

/// Returns True if the path is absolute (starts from root).
///
/// ```
/// is_absolute(new("/foo/bar"))  -> True
/// is_absolute(new("foo/bar"))   -> False
/// is_absolute(new("~"))          -> False
/// ```
pub is_absolute : Path -> Bool
pub is_absolute = |p| crash "intrinsic: Path.is_absolute"

/// Returns True if the path is relative (not absolute).
///
/// ```
/// is_relative(new("foo/bar"))   -> True
/// is_relative(new("/foo/bar"))   -> False
/// ```
pub is_relative : Path -> Bool
pub is_relative = |p| crash "intrinsic: Path.is_relative"

-- Conversion

/// Convert a Path to a string representation.
///
/// ```
/// to_str(new("foo/bar"))  -> "foo/bar"
/// ```
pub to_str : Path -> Str
pub to_str = |p| crash "intrinsic: Path.to_str"

/// Iterate over the components of a path.
///
/// ```
/// to_iter(new("foo/bar/baz"))  -> Iter(["foo", "bar", "baz"])
/// ```
pub to_iter : Path -> Iter(Str)
pub to_iter = |p| crash "intrinsic: Path.to_iter"