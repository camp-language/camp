// Path.camp

@Path : {}

// Construction

pub new = |s: Str| -> Path { crash "intrinsic: Path.new" }

pub join = |a: Path, b: Path| -> Path { crash "intrinsic: Path.join" }

pub from_list = |parts: List(Str)| -> Path { crash "intrinsic: Path.from_list" }

// Decomposition

pub parent = |p: Path| -> Option(Path) { crash "intrinsic: Path.parent" }

pub filename = |p: Path| -> Option(Str) { crash "intrinsic: Path.filename" }

pub stem = |p: Path| -> Option(Str) { crash "intrinsic: Path.stem" }

pub extension = |p: Path| -> Option(Str) { crash "intrinsic: Path.extension" }

// Manipulation

pub with_extension = |p: Path, ext: Str| -> Path { crash "intrinsic: Path.with_extension" }

pub with_filename = |p: Path, name: Str| -> Path { crash "intrinsic: Path.with_filename" }

pub with_parent = |p: Path, parent_path: Path| -> Path { crash "intrinsic: Path.with_parent" }

// Queries

pub is_absolute = |p: Path| -> Bool { crash "intrinsic: Path.is_absolute" }

pub is_relative = |p: Path| -> Bool { crash "intrinsic: Path.is_relative" }

// Conversion

pub to_str = |p: Path| -> Str { crash "intrinsic: Path.to_str" }

pub to_iter = |p: Path| -> Iter(Str) { crash "intrinsic: Path.to_iter" }

Path is Default {
  default = || -> Path { Path.new(".") }
}
Path is From {
  from = |val: Str| -> Path { Path.new(val) }
}

Path is TryFrom {
  try_from = |val: Bytes| -> Result(Path, ParseError) {
    crash "intrinsic: Path_from_bytes"
  }
}
Path is Debug {
    debug = |a: Self| -> Str { crash "intrinsic: Path_debug" }
}

Path is Ord {
    compare = |a: Self, b: Self| -> Order { crash "intrinsic: Path_compare" }
}

Path is Hash {
    hash = |a: Self, h: Hasher| -> Hasher { crash "intrinsic: Path_hash" }
}

Path is Eq {
    eq = |a: Self, b: Self| -> Bool { crash "intrinsic: Path_eq" }
}
