// @Duration — time duration (Rust-style signed struct)
// Per D24: { secs: I64, nanos: I64 } internally. Signed, ~584B yr range.
// DateTime is a separate package, not stdlib.

@Duration : {}

// Constructors

pub from_seconds = |s: I64| -> Duration { crash "intrinsic: Duration.from_seconds" }

pub from_millis = |ms: I64| -> Duration { crash "intrinsic: Duration.from_millis" }

pub from_micros = |us: I64| -> Duration { crash "intrinsic: Duration.from_micros" }

pub from_nanos = |ns: I64| -> Duration { crash "intrinsic: Duration.from_nanos" }

// Accessors

pub as_seconds = |d: Duration| -> I64 { crash "intrinsic: Duration.as_seconds" }

pub as_millis = |d: Duration| -> I64 { crash "intrinsic: Duration.as_millis" }

pub as_micros = |d: Duration| -> I64 { crash "intrinsic: Duration.as_micros" }

pub as_nanos = |d: Duration| -> I64 { crash "intrinsic: Duration.as_nanos" }

// Arithmetic

pub add = |a: Duration, b: Duration| -> Duration { crash "intrinsic: Duration.add" }

pub sub = |a: Duration, b: Duration| -> Duration { crash "intrinsic: Duration.sub" }

pub mul = |d: Duration, n: I64| -> Duration { crash "intrinsic: Duration.mul" }

pub neg = |d: Duration| -> Duration { crash "intrinsic: Duration.neg" }

pub abs = |d: Duration| -> Duration { crash "intrinsic: Duration.abs" }

// Comparison (via Ord)

pub is_zero = |d: Duration| -> Bool { crash "intrinsic: Duration.is_zero" }

// Constants

pub zero: Duration = crash "intrinsic: Duration.zero"

pub second: Duration = crash "intrinsic: Duration.second"

pub millisecond: Duration = crash "intrinsic: Duration.millisecond"

pub microsecond: Duration = crash "intrinsic: Duration.microsecond"

pub nanosecond: Duration = crash "intrinsic: Duration.nanosecond"
