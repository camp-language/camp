// Regex.camp — RE2-style regular expressions
// Per D37: guaranteed O(n), no backtracking, no backreferences, no lookahead/lookbehind.

@Regex : pub { pattern : Str }                  // opaque compiled regex

@RegexErr : pub [
    CompileError(Str)
  | InvalidEscape(Str)
  | InvalidRepeat(Str)
]

@MatchGroup : pub { value : Str, start : U64, end : U64 }
@Match : pub { full : Str, start : U64, end : U64, groups : List(MatchGroup) }

// Compilation — intrinsic

pub compile = |_pat: Str| -> Result(Regex, RegexErr) { crash "intrinsic: Regex.compile" }

pub is_match = |_r: Regex, _s: Str| -> Bool { crash "intrinsic: Regex.is_match" }

// Search — intrinsic

pub find = |_r: Regex, _s: Str| -> Result(Match, [Absent]) { crash "intrinsic: Regex.find" }  // first match only

pub find_all = |_r: Regex, _s: Str| -> List(Match) { crash "intrinsic: Regex.find_all" }  // all non-overlapping matches

// Transformation — intrinsic

pub replace = |_r: Regex, _s: Str, _rep: Str| -> Str { crash "intrinsic: Regex.replace" }  // first match, literal replacement

pub replace_all = |_r: Regex, _s: Str, _rep: Str| -> Str { crash "intrinsic: Regex.replace_all" }  // all matches, literal replacement

pub split = |_r: Regex, _s: Str| -> List(Str) { crash "intrinsic: Regex.split" }  // split on matches

pub splitn = |_r: Regex, _s: Str, _n: U64| -> List(Str) { crash "intrinsic: Regex.splitn" }  // at most n-1 splits

// Utility — pure Camp

pub escape = |_s: Str| -> Str { crash "intrinsic: Regex.escape" }  // escape regex metacharacters  // TODO: pure Camp implementation

Regex is TryFrom {
  try_from = |s: Str| -> Result(Regex, RegexErr) {
    Regex.compile(s)
  }
}
Regex is Debug {
    debug = |a: Self| -> Str { crash "intrinsic: Regex_debug" }
}
