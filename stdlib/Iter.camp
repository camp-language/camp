// Iter.camp
// @Iter(a, e): { next: || -[e]-> [Yield(a) | Done] }  -- declared by compiler

// Construction

pub empty: Iter(a) = crash "intrinsic: Iter.empty"

pub singleton = |x| { crash "intrinsic: Iter.singleton" }

pub from_list = |list| { crash "intrinsic: Iter.from_list" }

// Core transformations

pub map = |iter, f| { crash "intrinsic: Iter.map" }

pub filter = |iter, pred| { crash "intrinsic: Iter.filter" }

pub flat_map = |iter, f| { crash "intrinsic: Iter.flat_map" }

pub filter_map = |iter, f| { crash "intrinsic: Iter.filter_map" }

// Consumption

pub fold = |iter, init, f| { crash "intrinsic: Iter.fold" }

pub for_each = |iter, f| { crash "intrinsic: Iter.for_each" }

pub count = |iter| { crash "intrinsic: Iter.count" }

// Search

pub find = |iter, pred| { crash "intrinsic: Iter.find" }

pub any = |iter, pred| { crash "intrinsic: Iter.any" }

pub all = |iter, pred| { crash "intrinsic: Iter.all" }

pub contains = |iter, target| { crash "intrinsic: Iter.contains" }

// Slicing

pub take = |iter, n| { crash "intrinsic: Iter.take" }

pub skip = |iter, n| { crash "intrinsic: Iter.skip" }

pub take_while = |iter, pred| { crash "intrinsic: Iter.take_while" }

pub skip_while = |iter, pred| { crash "intrinsic: Iter.skip_while" }

// Composition

pub chain = |first, second| { crash "intrinsic: Iter.chain" }

pub zip = |left, right| { crash "intrinsic: Iter.zip" }

pub enumerate = |iter| { crash "intrinsic: Iter.enumerate" }
Iter is Debug {
    debug = |a: Self| -> Str { crash "intrinsic: Iter_debug" }
}

Iter is IntoIter {
  to_iter = |iter| { iter }
}
