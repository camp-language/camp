-- Env! effect — environment variables
-- Per D23: Env.try_get returns Result, not Throw!

effect Env! : {
  get!     : Str -> -[Env!, Throw!([VarNotFound])]-> Str,
  try_get  : Str -> -[Env!]-> Result(Str, [VarNotFound]),
  vars!    : -[Env!]-> List((Str, Str)),
  args!    : -[Env!]-> List(Str),
}
