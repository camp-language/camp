// List.camp
// @List(a): pub [Cons(a, List(a)) | Nil]  // declared by compiler

// Construction

pub empty = Nil

pub singleton = |x| { Cons(x, Nil) }

pub append = |xs, ys| {
  match xs {
    Nil => ys
    Cons(h, t) => Cons(h, append(t, ys))
  }
}

// Structural queries

pub length = |xs| {
  match xs {
    Nil => 0
    Cons(_head, t) => 1 + length(t)
  }
}

pub is_empty = |xs| {
  match xs {
    Nil => True
    Cons(_head, _tail) => False
  }
}

pub map = |xs, f| {
  match xs {
    Nil => Nil
    Cons(h, t) => Cons(f(h), map(t, f))
  }
}


// Head/tail access (Result per D3)

pub first = |xs| {
  match xs {
    Cons(h, _tail) => Ok(h)
    Nil => Err(ListWasEmpty)
  }
}

pub rest = |xs| {
  match xs {
    Cons(_head, t) => Ok(t)
    Nil => Err(ListWasEmpty)
  }
}

// NOTE: `last`, `sort`, `sort_by`, `to_iter`, `from_iter`, `filter`, and the
// trait impls (List is Debug/Ord/Hash/Eq) are intentionally omitted here for
// now. The redundancy analyzer (C0503) false-positives on `last`'s nested
// Cons/Nil pattern; `filter` triggers a WASM codegen i32/i64 type mismatch
// (if-in-match-arm with recursive List-returning branches); trait-impl
// lowering is tracked separately (camp-24mj). They will be restored once those
// blockers are resolved.
