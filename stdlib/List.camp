  crash "List.map: not yet implemented"
}

pub filter = <a>|pred: |a| -> Bool, xs: List(a)| -> List(a) {
  crash "List.filter: not yet implemented"
}

pub fold = <a, b>|f: |b, a| -> b, init: b, xs: List(a)| -> b {
  crash "List.fold: not yet implemented"
}

pub append = <a>|xs: List(a), ys: List(a)| -> List(a) {
  crash "List.append: not yet implemented"
}

pub head = <a>|xs: List(a)| -> Option(a) {
  match xs {
    Cons(h, _) => Some(h),
    Nil => None,
  }
}
