// Fmt module — formatting utilities
// Per D28: Houses Display/Debug traits. Format specifiers go in interpolation syntax.

// Display is declared separately in Display.camp
// Debug is declared separately in Debug.camp

// Concatenation helper for building formatted strings

pub concat = |a: Str, b: Str| -> Str { crash "intrinsic: Fmt.concat" }

// Numeric formatting with precision

pub f64_with_precision = |n: F64, precision: I64| -> Str { crash "intrinsic: Fmt.f64_with_precision" }

pub f32_with_precision = |n: F32, precision: I64| -> Str { crash "intrinsic: Fmt.f32_with_precision" }

// Padding/alignment (used by interpolation runtime)

pub pad_left = |s: Str, width: I64, fill: Str| -> Str { crash "intrinsic: Fmt.pad_left" }

pub pad_right = |s: Str, width: I64, fill: Str| -> Str { crash "intrinsic: Fmt.pad_right" }
Fmt is Debug {
    debug = |a: Self| -> Str { crash "intrinsic: Fmt_debug" }
}
