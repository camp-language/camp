
Char is Ord {
    compare = |a: Self, b: Self| -> Order {
        if a < b { Less } else if a == b { Equal } else { Greater }
    }
}

Char is Hash {
    hash = |a: Self, h: Hasher| -> Hasher { crash "intrinsic: Char_hash" }
}

Char is Eq {
    eq = |a: Self, b: Self| -> Bool { crash "intrinsic: Char_eq" }
}
