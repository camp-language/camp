// Uri.camp — URI/URL parsing and construction
// Per D36: query stored as raw string with parse_query/format_query helpers.
// Pure Camp — RFC 3986 parsing is bounded-complexity string scanning.

@UriAuthority : pub {
    userinfo : Result(Str, [Absent]),              // "user:password" (deprecated per RFC 3986 §3.2.1)
    host     : Str,
    port     : Result(U16, [Absent])
}

@Uri : pub {
    scheme    : Str,
    authority : Result(UriAuthority, [Absent]),
    path      : Str,
    query     : Result(Str, [Absent]),             // D36: raw percent-encoded string
    fragment  : Result(Str, [Absent])
}

@UriErr : pub [
    InvalidScheme(Str)
  | InvalidHost(Str)
  | InvalidPort(Str)
  | InvalidEscape(Str)
  | MissingScheme
]

// Parsing and formatting — pure Camp

pub parse = |_s| { crash "intrinsic: Uri.parse" }

pub to_str = |_u| { crash "intrinsic: Uri.to_str" }

// Component-level percent encoding — pure Camp

pub encode_component = |_s| { crash "intrinsic: Uri.encode_component" }

pub decode_component = |_s| { crash "intrinsic: Uri.decode_component" }

// Query string parsing (convenience) — pure Camp

pub parse_query = |_s| { crash "intrinsic: Uri.parse_query" }

pub format_query = |_pairs| { crash "intrinsic: Uri.format_query" }

// Functional construction helpers — pure Camp

pub with_scheme = |_s, _u| { crash "intrinsic: Uri.with_scheme" }

pub with_authority = |_a, _u| { crash "intrinsic: Uri.with_authority" }

pub with_path = |_p, _u| { crash "intrinsic: Uri.with_path" }

pub with_query = |_q, _u| { crash "intrinsic: Uri.with_query" }

pub with_fragment = |_f, _u| { crash "intrinsic: Uri.with_fragment" }