// Uri.camp — URI/URL parsing and construction
// Per D36: query stored as raw string with parse_query/format_query helpers.
// Pure Camp — RFC 3986 parsing is bounded-complexity string scanning.

@UriAuthority : pub {
    userinfo : Result(Str, [Absent]),              // "user:password" (deprecated per RFC 3986 §3.2.1)
    host     : Str,
    port     : Result(U16, [Absent])
}

@Uri : pub {
    scheme    : Str,
    authority : Result(UriAuthority, [Absent]),
    path      : Str,
    query     : Result(Str, [Absent]),             // D36: raw percent-encoded string
    fragment  : Result(Str, [Absent])
}

@UriErr : pub [
    InvalidScheme(Str)
  | InvalidHost(Str)
  | InvalidPort(Str)
  | InvalidEscape(Str)
  | MissingScheme
]

// Parsing and formatting — pure Camp

pub parse = |_s: Str| -> Result(Uri, UriErr) { crash "intrinsic: Uri.parse" }

pub to_str = |_u: Uri| -> Str { crash "intrinsic: Uri.to_str" }

// Component-level percent encoding — pure Camp

pub encode_component = |_s: Str| -> Str { crash "intrinsic: Uri.encode_component" }

pub decode_component = |_s: Str| -> Str { crash "intrinsic: Uri.decode_component" }

// Query string parsing (convenience) — pure Camp

pub parse_query = |_s: Str| -> List((Str, Str)) { crash "intrinsic: Uri.parse_query" }

pub format_query = |_pairs: List((Str, Str))| -> Str { crash "intrinsic: Uri.format_query" }

// Functional construction helpers — pure Camp

pub with_scheme = |_s: Str, _u: Uri| -> Uri { crash "intrinsic: Uri.with_scheme" }

pub with_authority = |_a: UriAuthority, _u: Uri| -> Uri { crash "intrinsic: Uri.with_authority" }

pub with_path = |_p: Str, _u: Uri| -> Uri { crash "intrinsic: Uri.with_path" }

pub with_query = |_q: Str, _u: Uri| -> Uri { crash "intrinsic: Uri.with_query" }

pub with_fragment = |_f: Str, _u: Uri| -> Uri { crash "intrinsic: Uri.with_fragment" }

Uri is Default {
  default = || -> Uri { crash "intrinsic: Uri_default" }
}
Uri is Debug {
    debug = |a: Self| -> Str { crash "intrinsic: Uri_debug" }
}

Uri is Ord {
    compare = |a: Self, b: Self| -> Order { crash "intrinsic: Uri_compare" }
}

Uri is Hash {
    hash = |a: Self, h: Hasher| -> Hasher { crash "intrinsic: Uri_hash" }
}

Uri is Eq {
    eq = |a: Self, b: Self| -> Bool { crash "intrinsic: Uri_eq" }
}
