// Uuid.camp — Universally Unique Identifiers
// Per D38: v4!/v7! use Random! only. Handler choice determines security.

@Uuid : pub Bytes                              // 16 bytes, opaque

@UuidErr : pub [
    InvalidFormat(Str)
  | InvalidLength(U64)
  | InvalidVersion(U8)
]

@UuidVariant : pub [V4 | V7 | Unknown(U8)]
@UuidFormat  : pub [Standard | Compact | Urn | Braced]

// Generation — effectful (intrinsic)

pub v4! = || { crash "intrinsic: Uuid.v4" }

pub v7! = |_ts| { crash "intrinsic: Uuid.v7" }

// Parsing — pure Camp

pub parse = |_s| { crash "intrinsic: Uuid.parse" }

pub from_bytes = |_b| { crash "intrinsic: Uuid.from_bytes" }

// Formatting — pure Camp

pub to_str = |_u| { crash "intrinsic: Uuid.to_str" }

pub format = |_fmt, _u| { crash "intrinsic: Uuid.format" }

pub to_bytes = |_u| { crash "intrinsic: Uuid.to_bytes" }

// Inspection — pure Camp

pub version = |_u| { crash "intrinsic: Uuid.version" }

pub variant = |_u| { crash "intrinsic: Uuid.variant" }

pub timestamp = |_u| { crash "intrinsic: Uuid.timestamp" }