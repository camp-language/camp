// Uuid.camp — Universally Unique Identifiers
// Per D38: v4!/v7! use Random! only. Handler choice determines security.

@Uuid : pub Bytes                              // 16 bytes, opaque

@UuidErr : pub [
    InvalidFormat(Str)
  | InvalidLength(U64)
  | InvalidVersion(U8)
]

@UuidVariant : pub [V4 | V7 | Unknown(U8)]
@UuidFormat  : pub [Standard | Compact | Urn | Braced]

// Generation — effectful (intrinsic)

pub v4! = || -> Uuid { crash "intrinsic: Uuid.v4" }

pub v7! = |_ts: U64| -> Uuid { crash "intrinsic: Uuid.v7" }

// Parsing — pure Camp

pub parse = |_s: Str| -> Result(Uuid, UuidErr) { crash "intrinsic: Uuid.parse" }

pub from_bytes = |_b: Bytes| -> Result(Uuid, UuidErr) { crash "intrinsic: Uuid.from_bytes" }

// Formatting — pure Camp

pub to_str = |_u: Uuid| -> Str { crash "intrinsic: Uuid.to_str" }

pub format = |_fmt: UuidFormat, _u: Uuid| -> Str { crash "intrinsic: Uuid.format" }

pub to_bytes = |_u: Uuid| -> Bytes { crash "intrinsic: Uuid.to_bytes" }

// Inspection — pure Camp

pub version = |_u: Uuid| -> U8 { crash "intrinsic: Uuid.version" }

pub variant = |_u: Uuid| -> UuidVariant { crash "intrinsic: Uuid.variant" }

pub timestamp = |_u: Uuid| -> U64 { crash "intrinsic: Uuid.timestamp" }

Uuid is Default {
  default = || -> Uuid { crash "intrinsic: Uuid_nil" }
}
Uuid is From {
  from = |val: Uuid| -> Str { Uuid.to_str(val) }
}
Uuid is From {
  from = |val: Uuid| -> Bytes { Uuid.to_bytes(val) }
}

Uuid is TryFrom {
  try_from = |s: Str| -> Result(Uuid, UuidErr) {
    Uuid.parse(s)
  }
}
Uuid is Debug {
    debug = |a: Self| -> Str { crash "intrinsic: Uuid_debug" }
}
