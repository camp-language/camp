@Result(a, e): pub [Ok(a) | Err(e)]

// Core combinators

pub map = |r, f| {
  match r {
    Ok(v) => Ok(f(v))
    Err(e) => Err(e)
  }
}

pub map_err = |r, f| {
  match r {
    Ok(v) => Ok(v)
    Err(e) => Err(f(e))
  }
}

pub and_then = |r, f| {
  match r {
    Ok(v) => f(v)
    Err(e) => Err(e)
  }
}

pub or_else = |r, f| {
  match r {
    Ok(v) => Ok(v)
    Err(_e) => f()
  }
}

// Predicates

pub is_ok = |r| {
  match r {
    Ok(_v) => True
    Err(_e) => False
  }
}

pub is_err = |r| {
  match r {
    Ok(_v) => False
    Err(_e) => True
  }
}

// Unwrapping

pub unwrap = |r| {
  match r {
    Ok(v) => v
    Err(_e) => crash "Result.unwrap: called on Err"
  }
}

pub unwrap_or = |r, default| {
  match r {
    Ok(v) => v
    Err(_e) => default
  }
}

pub unwrap_or_else = |r, f| {
  match r {
    Ok(v) => v
    Err(e) => f(e)
  }
}

pub unwrap_or_default = |r| {
  match r {
    Ok(v) => v
    Err(_e) => Default.default
  }
}

// Boolean composition

pub or = |r1, r2| {
  match r1 {
    Ok(v) => Ok(v)
    Err(_e) => r2
  }
}

// Filtering

pub filter = |r, pred, err| {
  match r {
    Ok(v) => if pred(v) { Ok(v) } else { Err(err) }
    Err(e) => Err(e)
  }
}

// Flattening

pub flatten = |r| {
  match r {
    Ok(inner) => inner
    Err(e) => Err(e)
  }
}

// Conversion

pub to_list = |r| {
  match r {
    Ok(v) => [v]
    Err(_e) => []
  }
}

pub from_list = |xs| {
  match xs {
    Cons(h, _t) => Ok(h)
    Nil => Err(EmptyList)
  }
}

// Effect bridging — intrinsic

pub unwrap! = |r| { crash "intrinsic: Result.unwrap!" }

pub catch = |action| { crash "intrinsic: Result.catch" }

// Tests

test "core combinators cover all paths" {
  expect is_ok(Ok(42))
  expect is_err(Err("x"))
  expect not is_ok(Err("x"))
  expect not is_err(Ok(42))
  expect unwrap(Ok(42)) == 42
  expect unwrap_or(Ok(42), 0) == 42
  expect unwrap_or(Err("x"), 0) == 0
  expect unwrap_or_else(Ok(42), \|_\| 0) == 42
  expect unwrap_or_else(Err("x"), \|_\| 0) == 0
  expect is_ok(map(Ok(42), \|x\| x + 1))
  expect is_err(map(Err("e"), \|x\| x))
  expect is_ok(map_err(Ok(42), \|_\| "y"))
  expect is_err(map_err(Err("e"), \|_\| "y"))
  expect is_ok(and_then(Ok(42), \|x\| Ok(x + 1)))
  expect is_err(and_then(Err("e"), \|x\| Ok(x)))
  expect is_ok(or_else(Ok(42), \|\| Ok(0)))
  expect is_ok(or_else(Err("e"), \|\| Ok(0)))
  expect is_ok(or(Ok(1), Ok(2)))
  expect is_ok(or(Err("e"), Ok(2)))
  expect is_err(or(Err("a"), Err("b")))
  expect is_ok(flatten(Ok(Ok(42))))
  expect is_err(flatten(Ok(Err("e"))))
  expect is_err(flatten(Err("outer")))
  expect is_ok(filter(Ok(42), \|x\| x > 0, "filtered"))
  expect is_err(filter(Ok(0), \|x\| x > 0, "filtered"))
  expect is_err(filter(Err("base"), \|x\| True, "err"))
  expect match to_list(Ok(42)) { Cons(h, Nil) => h == 42 | _ => False }
  expect match to_list(Err("x")) { Nil => True | _ => False }
  expect is_ok(from_list([42]))
  expect is_err(from_list([]))
}
