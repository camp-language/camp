@Result(a, e): pub [Ok(a) | Err(e)]

// Core combinators

pub map = |r, f| {
  match r {
    Ok(v) => Ok(f(v))
    Err(e) => Err(e)
  }
}

pub map_err = |r, f| {
  match r {
    Ok(v) => Ok(v)
    Err(e) => Err(f(e))
  }
}

pub and_then = |r, f| {
  match r {
    Ok(v) => f(v)
    Err(e) => Err(e)
  }
}

pub or_else = |r, f| {
  match r {
    Ok(v) => Ok(v)
    Err(_e) => f()
  }
}

// Predicates

pub is_ok = |r| {
  match r {
    Ok(_v) => True
    Err(_e) => False
  }
}

pub is_err = |r| {
  match r {
    Ok(_v) => False
    Err(_e) => True
  }
}

// Unwrapping

pub unwrap = |r| {
  match r {
    Ok(v) => v
    Err(_e) => crash "Result.unwrap: called on Err"
  }
}

pub unwrap_or = |r, default| {
  match r {
    Ok(v) => v
    Err(_e) => default
  }
}

pub unwrap_or_else = |r, f| {
  match r {
    Ok(v) => v
    Err(e) => f(e)
  }
}

pub unwrap_or_default = |r| { crash "intrinsic: Result.unwrap_or_default" }

// Boolean composition

pub or = |r1, r2| {
  match r1 {
    Ok(v) => Ok(v)
    Err(_e) => r2
  }
}

// Filtering

pub filter = |r, pred, err| {
  match r {
    Ok(v) => if pred(v) { Ok(v) } else { Err(err) }
    Err(e) => Err(e)
  }
}

// Flattening

pub flatten = |r| {
  match r {
    Ok(inner) => inner
    Err(e) => Err(e)
  }
}

// Conversion

pub to_list = |r| {
  match r {
    Ok(v) => [v]
    Err(_e) => []
  }
}

pub from_list = |xs| {
  match xs {
    Cons(h, _t) => Ok(h)
    Nil => Err(EmptyList)
  }
}

// Effect bridging — intrinsic

pub unwrap! = |r| { crash "intrinsic: Result.unwrap!" }

pub catch = |action| { crash "intrinsic: Result.catch" }

