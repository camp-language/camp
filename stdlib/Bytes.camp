// @Bytes — opaque contiguous byte buffer, provided by runtime
// Per D19: Lean module (construction, queries, access, slicing, concat).
// Conversions via traits: From(Str, Bytes) infallible,
// TryFrom(Bytes, Str, [InvalidUtf8]) fallible.

// Construction

pub new = crash "intrinsic: Bytes.new"

pub from_list = |xs: List(U8)| -> Bytes { crash "intrinsic: Bytes.from_list" }

pub singleton = |b: U8| -> Bytes { crash "intrinsic: Bytes.singleton" }

// Queries

pub length = |b: Bytes| -> I64 { crash "intrinsic: Bytes.length" }

pub is_empty = |b: Bytes| -> Bool { length(b) == 0 }

// Access

pub get = |i: I64, b: Bytes| -> U8 { crash "intrinsic: Bytes.get" }

// Slicing

pub take = |b: Bytes, n: I64| -> Bytes { crash "intrinsic: Bytes.take" }

pub drop = |b: Bytes, n: I64| -> Bytes { crash "intrinsic: Bytes.drop" }

pub slice = |b: Bytes, start: I64, len: I64| -> Bytes { crash "intrinsic: Bytes.slice" }

// Concatenation

pub concat = |a: Bytes, b: Bytes| -> Bytes { crash "intrinsic: Bytes.concat" }

// Iteration

pub to_iter = |b: Bytes| -> Iter(U8) { crash "intrinsic: Bytes.to_iter" }

// Conversion

pub to_list = |b: Bytes| -> List(U8) { crash "intrinsic: Bytes.to_list" }

pub to_str = |b: Bytes| -> Result(Str, [InvalidUtf8]) { crash "intrinsic: Bytes.to_str" }
Bytes is Eq {
    eq = |a: Self, b: Self| -> Bool { crash "intrinsic: Bytes_eq" }
}

Bytes is Default {
  default = || -> Bytes { crash "intrinsic: Bytes_new" }
}
