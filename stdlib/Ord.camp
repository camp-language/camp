// Ord trait — total ordering
// Per D16: Order is structural tag union [Less | Equal | Greater]

@Order : pub [Less | Equal | Greater]

Ord : { compare : |Self, Self| -> Order }
Order is Debug {
    debug = |a: Self| -> Str {
        match a {
            Less => "Less"
            Equal => "Equal"
            Greater => "Greater"
        }
    }
}
