// Ord trait — total ordering
// Per D16: Order is a structural tag union [Less | Equal | Greater], declared
// in the prelude (not a nominal newtype). `Less`/`Equal`/`Greater` are the
// Order constructors.

Ord : { compare : |Self, Self| -> Order }
Order is Debug {
    debug = |a: Self| -> Str {
        match a {
            Less => "Less"
            Equal => "Equal"
            Greater => "Greater"
        }
    }
}

