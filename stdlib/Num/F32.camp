// Num/F32.camp
// Operations on F32.

pub abs = |n: F32| -> F32 { crash "intrinsic: Num.F32.abs" }

pub clamp = |lo: F32, hi: F32, n: F32| -> F32 { if n < lo { lo } else if n > hi { hi } else { n } }

pub max = |a: F32, b: F32| -> F32 { crash "intrinsic: Num.F32.max" }

pub min = |a: F32, b: F32| -> F32 { crash "intrinsic: Num.F32.min" }

pub neg = |n: F32| -> F32 { 0.0 - n }

pub ceiling = |n: F32| -> F32 { crash "intrinsic: Num.F32.ceiling" }

pub floor = |n: F32| -> F32 { crash "intrinsic: Num.F32.floor" }

pub round = |n: F32| -> F32 { crash "intrinsic: Num.F32.round" }

pub truncate = |n: F32| -> F32 { crash "intrinsic: Num.F32.truncate" }

pub is_nan = |n: F32| -> Bool { crash "intrinsic: Num.F32.is_nan" }

pub is_infinite = |n: F32| -> Bool { crash "intrinsic: Num.F32.is_infinite" }

pub is_finite = |n: F32| -> Bool { crash "intrinsic: Num.F32.is_finite" }

pub pi: F32 = 3.14159265
pub e: F32 = 2.71828182
pub nan: F32 = crash "intrinsic: Num.F32.nan"
pub infinity: F32 = crash "intrinsic: Num.F32.infinity"
pub neg_infinity: F32 = crash "intrinsic: Num.F32.neg_infinity"

pub sin = |n: F32| -> F32 { crash "intrinsic: Num.F32.sin" }

pub cos = |n: F32| -> F32 { crash "intrinsic: Num.F32.cos" }

pub tan = |n: F32| -> F32 { crash "intrinsic: Num.F32.tan" }

pub asin = |n: F32| -> F32 { crash "intrinsic: Num.F32.asin" }

pub acos = |n: F32| -> F32 { crash "intrinsic: Num.F32.acos" }

pub atan = |n: F32| -> F32 { crash "intrinsic: Num.F32.atan" }

pub atan2 = |y: F32, x: F32| -> F32 { crash "intrinsic: Num.F32.atan2" }

pub exp = |n: F32| -> F32 { crash "intrinsic: Num.F32.exp" }

pub log = |n: F32| -> F32 { crash "intrinsic: Num.F32.log" }

pub log2 = |n: F32| -> F32 { crash "intrinsic: Num.F32.log2" }

pub log10 = |n: F32| -> F32 { crash "intrinsic: Num.F32.log10" }

pub pow = |base: F32, exp_val: F32| -> F32 { crash "intrinsic: Num.F32.pow" }

pub sqrt = |n: F32| -> F32 { crash "intrinsic: Num.F32.sqrt" }

pub to_str = |n: F32| -> Str { crash "intrinsic: Num.F32.to_str" }

pub from_str = |s: Str| -> F32 { crash "intrinsic: Num.F32.from_str" }

pub to_i64 = |n: F32| -> I64 { crash "intrinsic: Num.F32.to_i64" }

pub from_i64 = |n: I64| -> F32 { crash "intrinsic: Num.F32.from_i64" }
Num.F32 is Eq {
    eq = |a: Self, b: Self| -> Bool { crash "intrinsic: Num.F32_eq" }
}
