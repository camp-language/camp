// Num/U64.camp
// Operations on U64. Unsigned — no abs or neg.

pub clamp = |lo: U64, hi: U64, n: U64| -> U64 { if n < lo { lo } else if n > hi { hi } else { n } }

pub max = |a: U64, b: U64| -> U64 { if a > b { a } else { b } }

pub min = |a: U64, b: U64| -> U64 { if a < b { a } else { b } }

pub checked_add = |a: U64, b: U64| -> U64 { crash "intrinsic: Num.U64.checked_add" }

pub checked_sub = |a: U64, b: U64| -> U64 { crash "intrinsic: Num.U64.checked_sub" }

pub checked_mul = |a: U64, b: U64| -> U64 { crash "intrinsic: Num.U64.checked_mul" }

pub wrapping_add = |a: U64, b: U64| -> U64 { crash "intrinsic: Num.U64.wrapping_add" }

pub saturating_add = |a: U64, b: U64| -> U64 { crash "intrinsic: Num.U64.saturating_add" }

pub saturating_sub = |a: U64, b: U64| -> U64 { crash "intrinsic: Num.U64.saturating_sub" }

pub to_str = |n: U64| -> Str { crash "intrinsic: Num.U64.to_str" }

pub from_str = |s: Str| -> U64 { crash "intrinsic: Num.U64.from_str" }

pub range = |start: U64, end: U64| { crash "intrinsic: Num.U64.range" }

pub bitwise_and = |a: U64, b: U64| -> U64 { crash "intrinsic: Num.U64.bitwise_and" }

pub bitwise_or = |a: U64, b: U64| -> U64 { crash "intrinsic: Num.U64.bitwise_or" }

pub bitwise_xor = |a: U64, b: U64| -> U64 { crash "intrinsic: Num.U64.bitwise_xor" }

pub bitwise_not = |a: U64| -> U64 { crash "intrinsic: Num.U64.bitwise_not" }

pub shift_left = |a: U64, n: U64| -> U64 { crash "intrinsic: Num.U64.shift_left" }

pub shift_right = |a: U64, n: U64| -> U64 { crash "intrinsic: Num.U64.shift_right" }

pub count_ones = |n: U64| -> U64 { crash "intrinsic: Num.U64.count_ones" }

pub leading_zeros = |n: U64| -> U64 { crash "intrinsic: Num.U64.leading_zeros" }

pub trailing_zeros = |n: U64| -> U64 { crash "intrinsic: Num.U64.trailing_zeros" }
U64 is Eq {
    eq = |a: Self, b: Self| -> Bool { crash "intrinsic: U64_eq" }
}
U64 is TryFrom {
  try_from = |val: U64| -> Result(U8, TryFromIntError) { crash "intrinsic: U64_try_into_U8" }
}
U64 is TryFrom {
  try_from = |val: U64| -> Result(U16, TryFromIntError) { crash "intrinsic: U64_try_into_U16" }
}
U64 is TryFrom {
  try_from = |val: U64| -> Result(U32, TryFromIntError) { crash "intrinsic: U64_try_into_U32" }
}
U64 is TryFrom {
  try_from = |val: U64| -> Result(I8, TryFromIntError) { crash "intrinsic: U64_try_into_I8" }
}
U64 is TryFrom {
  try_from = |val: U64| -> Result(I16, TryFromIntError) { crash "intrinsic: U64_try_into_I16" }
}
U64 is TryFrom {
  try_from = |val: U64| -> Result(I32, TryFromIntError) { crash "intrinsic: U64_try_into_I32" }
}
U64 is TryFrom {
  try_from = |val: U64| -> Result(I64, TryFromIntError) { crash "intrinsic: U64_try_into_I64" }
}
U64 is TryFrom {
  try_from = |val: U64| -> Result(F32, TryFromIntError) { crash "intrinsic: U64_try_into_F32" }
}
U64 is TryFrom {
  try_from = |val: U64| -> Result(F64, TryFromIntError) { crash "intrinsic: U64_try_into_F64" }
}

U64 is Debug {
    debug = |a: Self| -> Str { crash "intrinsic: U64_debug" }
}

U64 is Ord {
    compare = |a: Self, b: Self| -> Order {
        if a < b { Less } else if a == b { Equal } else { Greater }
    }
}

U64 is Hash {
    hash = |a: Self, h: Hasher| -> Hasher { crash "intrinsic: U64_hash" }
}

test "U64 traits" {
  expect 0 == 0
  expect 42 == 42
  expect not (0 == 1)
  expect 0 < 1
  expect 4294967295 > 0
  expect 42 <= 42
  expect 42 >= 42
  u64_val: U64 = 4294967295
  expect u64_val == 4294967295
}
