// Num/I16.camp
// Operations on I16.

pub abs = |n: I16| -> I16 { if n < 0 { 0 - n } else { n } }

pub clamp = |lo: I16, hi: I16, n: I16| -> I16 { if n < lo { lo } else if n > hi { hi } else { n } }

pub max = |a: I16, b: I16| -> I16 { if a > b { a } else { b } }

pub min = |a: I16, b: I16| -> I16 { if a < b { a } else { b } }

pub neg = |n: I16| -> I16 { 0 - n }

pub checked_add = |a: I16, b: I16| -> I16 { crash "intrinsic: Num.I16.checked_add" }

pub checked_sub = |a: I16, b: I16| -> I16 { crash "intrinsic: Num.I16.checked_sub" }

pub checked_mul = |a: I16, b: I16| -> I16 { crash "intrinsic: Num.I16.checked_mul" }

pub wrapping_add = |a: I16, b: I16| -> I16 { crash "intrinsic: Num.I16.wrapping_add" }

pub saturating_add = |a: I16, b: I16| -> I16 { crash "intrinsic: Num.I16.saturating_add" }

pub saturating_sub = |a: I16, b: I16| -> I16 { crash "intrinsic: Num.I16.saturating_sub" }

pub to_str = |n: I16| -> Str { crash "intrinsic: Num.I16.to_str" }

pub from_str = |s: Str| -> I16 { crash "intrinsic: Num.I16.from_str" }

pub bitwise_and = |a: I16, b: I16| -> I16 { crash "intrinsic: Num.I16.bitwise_and" }

pub bitwise_or = |a: I16, b: I16| -> I16 { crash "intrinsic: Num.I16.bitwise_or" }

pub bitwise_xor = |a: I16, b: I16| -> I16 { crash "intrinsic: Num.I16.bitwise_xor" }

pub bitwise_not = |a: I16| -> I16 { crash "intrinsic: Num.I16.bitwise_not" }

pub shift_left = |a: I16, n: I16| -> I16 { crash "intrinsic: Num.I16.shift_left" }

pub shift_right = |a: I16, n: I16| -> I16 { crash "intrinsic: Num.I16.shift_right" }

pub count_ones = |n: I16| -> I16 { crash "intrinsic: Num.I16.count_ones" }

pub leading_zeros = |n: I16| -> I16 { crash "intrinsic: Num.I16.leading_zeros" }

pub trailing_zeros = |n: I16| -> I16 { crash "intrinsic: Num.I16.trailing_zeros" }
Num.I16 is Eq {
    eq = |a: Self, b: Self| -> Bool { crash "intrinsic: Num.I16_eq" }
}
I16 is TryFrom {
  try_from = |val: I16| -> Result(I8, TryFromIntError) { crash "intrinsic: I16_try_into_I8" }
}
I16 is TryFrom {
  try_from = |val: I16| -> Result(U8, TryFromIntError) { crash "intrinsic: I16_try_into_U8" }
}
I16 is TryFrom {
  try_from = |val: I16| -> Result(U16, TryFromIntError) { crash "intrinsic: I16_try_into_U16" }
}
I16 is TryFrom {
  try_from = |val: I16| -> Result(U32, TryFromIntError) { crash "intrinsic: I16_try_into_U32" }
}
I16 is TryFrom {
  try_from = |val: I16| -> Result(U64, TryFromIntError) { crash "intrinsic: I16_try_into_U64" }
}
I16 is TryFrom {
  try_from = |val: I16| -> Result(F32, TryFromIntError) { crash "intrinsic: I16_try_into_F32" }
}

I16 is Debug {
    debug = |a: Self| -> Str { crash "intrinsic: I16_debug" }
}
