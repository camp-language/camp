// Num/I8.camp
// Operations on I8.

pub abs = |n: I8| -> I8 { if n < 0 { 0 - n } else { n } }

pub clamp = |lo: I8, hi: I8, n: I8| -> I8 { if n < lo { lo } else if n > hi { hi } else { n } }

pub max = |a: I8, b: I8| -> I8 { if a > b { a } else { b } }

pub min = |a: I8, b: I8| -> I8 { if a < b { a } else { b } }

pub neg = |n: I8| -> I8 { 0 - n }

pub checked_add = |a: I8, b: I8| -> I8 { crash "intrinsic: Num.I8.checked_add" }

pub checked_sub = |a: I8, b: I8| -> I8 { crash "intrinsic: Num.I8.checked_sub" }

pub checked_mul = |a: I8, b: I8| -> I8 { crash "intrinsic: Num.I8.checked_mul" }

pub wrapping_add = |a: I8, b: I8| -> I8 { crash "intrinsic: Num.I8.wrapping_add" }

pub saturating_add = |a: I8, b: I8| -> I8 { crash "intrinsic: Num.I8.saturating_add" }

pub saturating_sub = |a: I8, b: I8| -> I8 { crash "intrinsic: Num.I8.saturating_sub" }

pub to_str = |n: I8| -> Str { crash "intrinsic: Num.I8.to_str" }

pub from_str = |s: Str| -> I8 { crash "intrinsic: Num.I8.from_str" }

pub bitwise_and = |a: I8, b: I8| -> I8 { crash "intrinsic: Num.I8.bitwise_and" }

pub bitwise_or = |a: I8, b: I8| -> I8 { crash "intrinsic: Num.I8.bitwise_or" }

pub bitwise_xor = |a: I8, b: I8| -> I8 { crash "intrinsic: Num.I8.bitwise_xor" }

pub bitwise_not = |a: I8| -> I8 { crash "intrinsic: Num.I8.bitwise_not" }

pub shift_left = |a: I8, n: I8| -> I8 { crash "intrinsic: Num.I8.shift_left" }

pub shift_right = |a: I8, n: I8| -> I8 { crash "intrinsic: Num.I8.shift_right" }

pub count_ones = |n: I8| -> I8 { crash "intrinsic: Num.I8.count_ones" }

pub leading_zeros = |n: I8| -> I8 { crash "intrinsic: Num.I8.leading_zeros" }

pub trailing_zeros = |n: I8| -> I8 { crash "intrinsic: Num.I8.trailing_zeros" }
Num.I8 is Eq {
    eq = |a: Self, b: Self| -> Bool { crash "intrinsic: Num.I8_eq" }
}
I8 is Default {
  default = || -> I8 { crash "intrinsic: I8_default" }
}
I8 is From {
  from = |val: I8| -> I16 { crash "intrinsic: I8_to_I16" }
}
I8 is From {
  from = |val: I8| -> I32 { crash "intrinsic: I8_to_I32" }
}
I8 is From {
  from = |val: I8| -> I64 { crash "intrinsic: I8_to_I64" }
}
I8 is From {
  from = |val: I8| -> F32 { crash "intrinsic: I8_to_F32" }
}
I8 is From {
  from = |val: I8| -> F64 { crash "intrinsic: I8_to_F64" }
}
I8 is TryFrom {
  try_from = |val: I8| -> Result(U8, TryFromIntError) { crash "intrinsic: I8_try_into_U8" }
}
I8 is TryFrom {
  try_from = |val: I8| -> Result(U16, TryFromIntError) { crash "intrinsic: I8_try_into_U16" }
}
I8 is TryFrom {
  try_from = |val: I8| -> Result(U32, TryFromIntError) { crash "intrinsic: I8_try_into_U32" }
}
I8 is TryFrom {
  try_from = |val: I8| -> Result(U64, TryFromIntError) { crash "intrinsic: I8_try_into_U64" }
}
I8 is TryFrom {
  try_from = |val: I8| -> Result(F32, TryFromIntError) { crash "intrinsic: I8_try_into_F32" }
}