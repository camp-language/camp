// Num/U32.camp
// Operations on U32. Unsigned — no abs or neg.

pub clamp = |lo: U32, hi: U32, n: U32| -> U32 { if n < lo { lo } else if n > hi { hi } else { n } }

pub max = |a: U32, b: U32| -> U32 { if a > b { a } else { b } }

pub min = |a: U32, b: U32| -> U32 { if a < b { a } else { b } }

pub checked_add = |a: U32, b: U32| -> U32 { crash "intrinsic: Num.U32.checked_add" }

pub checked_sub = |a: U32, b: U32| -> U32 { crash "intrinsic: Num.U32.checked_sub" }

pub checked_mul = |a: U32, b: U32| -> U32 { crash "intrinsic: Num.U32.checked_mul" }

pub wrapping_add = |a: U32, b: U32| -> U32 { crash "intrinsic: Num.U32.wrapping_add" }

pub saturating_add = |a: U32, b: U32| -> U32 { crash "intrinsic: Num.U32.saturating_add" }

pub saturating_sub = |a: U32, b: U32| -> U32 { crash "intrinsic: Num.U32.saturating_sub" }

pub to_str = |n: U32| -> Str { crash "intrinsic: Num.U32.to_str" }

pub from_str = |s: Str| -> U32 { crash "intrinsic: Num.U32.from_str" }

pub bitwise_and = |a: U32, b: U32| -> U32 { crash "intrinsic: Num.U32.bitwise_and" }

pub bitwise_or = |a: U32, b: U32| -> U32 { crash "intrinsic: Num.U32.bitwise_or" }

pub bitwise_xor = |a: U32, b: U32| -> U32 { crash "intrinsic: Num.U32.bitwise_xor" }

pub bitwise_not = |a: U32| -> U32 { crash "intrinsic: Num.U32.bitwise_not" }

pub shift_left = |a: U32, n: U32| -> U32 { crash "intrinsic: Num.U32.shift_left" }

pub shift_right = |a: U32, n: U32| -> U32 { crash "intrinsic: Num.U32.shift_right" }

pub count_ones = |n: U32| -> U32 { crash "intrinsic: Num.U32.count_ones" }

pub leading_zeros = |n: U32| -> U32 { crash "intrinsic: Num.U32.leading_zeros" }

pub trailing_zeros = |n: U32| -> U32 { crash "intrinsic: Num.U32.trailing_zeros" }
Num.U32 is Eq {
    eq = |a: Self, b: Self| -> Bool { crash "intrinsic: Num.U32_eq" }
}
U32 is Default {
  default = || -> U32 { crash "intrinsic: U32_default" }
}
U32 is From {
  from = |val: U32| -> U64 { crash "intrinsic: U32_to_U64" }
}
U32 is From {
  from = |val: U32| -> F64 { crash "intrinsic: U32_to_F64" }
}
U32 is TryFrom {
  try_from = |val: U32| -> Result(U8, TryFromIntError) { crash "intrinsic: U32_try_into_U8" }
}
U32 is TryFrom {
  try_from = |val: U32| -> Result(U16, TryFromIntError) { crash "intrinsic: U32_try_into_U16" }
}
U32 is TryFrom {
  try_from = |val: U32| -> Result(I8, TryFromIntError) { crash "intrinsic: U32_try_into_I8" }
}
U32 is TryFrom {
  try_from = |val: U32| -> Result(I16, TryFromIntError) { crash "intrinsic: U32_try_into_I16" }
}
U32 is TryFrom {
  try_from = |val: U32| -> Result(I32, TryFromIntError) { crash "intrinsic: U32_try_into_I32" }
}
U32 is TryFrom {
  try_from = |val: U32| -> Result(F32, TryFromIntError) { crash "intrinsic: U32_try_into_F32" }
}