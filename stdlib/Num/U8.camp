// Num/U8.camp
// Operations on U8. Unsigned — no abs or neg.

pub clamp = |lo: U8, hi: U8, n: U8| -> U8 { if n < lo { lo } else if n > hi { hi } else { n } }

pub max = |a: U8, b: U8| -> U8 { if a > b { a } else { b } }

pub min = |a: U8, b: U8| -> U8 { if a < b { a } else { b } }

pub checked_add = |a: U8, b: U8| -> U8 { crash "intrinsic: Num.U8.checked_add" }

pub checked_sub = |a: U8, b: U8| -> U8 { crash "intrinsic: Num.U8.checked_sub" }

pub checked_mul = |a: U8, b: U8| -> U8 { crash "intrinsic: Num.U8.checked_mul" }

pub wrapping_add = |a: U8, b: U8| -> U8 { crash "intrinsic: Num.U8.wrapping_add" }

pub saturating_add = |a: U8, b: U8| -> U8 { crash "intrinsic: Num.U8.saturating_add" }

pub saturating_sub = |a: U8, b: U8| -> U8 { crash "intrinsic: Num.U8.saturating_sub" }

pub to_str = |n: U8| -> Str { crash "intrinsic: Num.U8.to_str" }

pub from_str = |s: Str| -> U8 { crash "intrinsic: Num.U8.from_str" }

pub bitwise_and = |a: U8, b: U8| -> U8 { crash "intrinsic: Num.U8.bitwise_and" }

pub bitwise_or = |a: U8, b: U8| -> U8 { crash "intrinsic: Num.U8.bitwise_or" }

pub bitwise_xor = |a: U8, b: U8| -> U8 { crash "intrinsic: Num.U8.bitwise_xor" }

pub bitwise_not = |a: U8| -> U8 { crash "intrinsic: Num.U8.bitwise_not" }

pub shift_left = |a: U8, n: U8| -> U8 { crash "intrinsic: Num.U8.shift_left" }

pub shift_right = |a: U8, n: U8| -> U8 { crash "intrinsic: Num.U8.shift_right" }

pub count_ones = |n: U8| -> U8 { crash "intrinsic: Num.U8.count_ones" }

pub leading_zeros = |n: U8| -> U8 { crash "intrinsic: Num.U8.leading_zeros" }

pub trailing_zeros = |n: U8| -> U8 { crash "intrinsic: Num.U8.trailing_zeros" }
Num.U8 is Eq {
    eq = |a: Self, b: Self| -> Bool { crash "intrinsic: Num.U8_eq" }
}
U8 is TryFrom {
  try_from = |val: U8| -> Result(I8, TryFromIntError) { crash "intrinsic: U8_try_into_I8" }
}

U8 is Debug {
    debug = |a: Self| -> Str { crash "intrinsic: U8_debug" }
}

U8 is Ord {
    compare = |a: Self, b: Self| -> Order {
        if a < b { Less } else if a == b { Equal } else { Greater }
    }
}

U8 is Hash {
    hash = |a: Self, h: Hasher| -> Hasher { crash "intrinsic: U8_hash" }
}
