// Num/U16.camp
// Operations on U16. Unsigned — no abs or neg.

pub clamp = |lo: U16, hi: U16, n: U16| -> U16 { if n < lo { lo } else if n > hi { hi } else { n } }

pub max = |a: U16, b: U16| -> U16 { if a > b { a } else { b } }

pub min = |a: U16, b: U16| -> U16 { if a < b { a } else { b } }

pub checked_add = |a: U16, b: U16| -> U16 { crash "intrinsic: Num.U16.checked_add" }

pub checked_sub = |a: U16, b: U16| -> U16 { crash "intrinsic: Num.U16.checked_sub" }

pub checked_mul = |a: U16, b: U16| -> U16 { crash "intrinsic: Num.U16.checked_mul" }

pub wrapping_add = |a: U16, b: U16| -> U16 { crash "intrinsic: Num.U16.wrapping_add" }

pub saturating_add = |a: U16, b: U16| -> U16 { crash "intrinsic: Num.U16.saturating_add" }

pub saturating_sub = |a: U16, b: U16| -> U16 { crash "intrinsic: Num.U16.saturating_sub" }

pub to_str = |n: U16| -> Str { crash "intrinsic: Num.U16.to_str" }

pub from_str = |s: Str| -> U16 { crash "intrinsic: Num.U16.from_str" }

pub bitwise_and = |a: U16, b: U16| -> U16 { crash "intrinsic: Num.U16.bitwise_and" }

pub bitwise_or = |a: U16, b: U16| -> U16 { crash "intrinsic: Num.U16.bitwise_or" }

pub bitwise_xor = |a: U16, b: U16| -> U16 { crash "intrinsic: Num.U16.bitwise_xor" }

pub bitwise_not = |a: U16| -> U16 { crash "intrinsic: Num.U16.bitwise_not" }

pub shift_left = |a: U16, n: U16| -> U16 { crash "intrinsic: Num.U16.shift_left" }

pub shift_right = |a: U16, n: U16| -> U16 { crash "intrinsic: Num.U16.shift_right" }

pub count_ones = |n: U16| -> U16 { crash "intrinsic: Num.U16.count_ones" }

pub leading_zeros = |n: U16| -> U16 { crash "intrinsic: Num.U16.leading_zeros" }

pub trailing_zeros = |n: U16| -> U16 { crash "intrinsic: Num.U16.trailing_zeros" }
U16 is Eq {
    eq = |a: Self, b: Self| -> Bool { crash "intrinsic: U16_eq" }
}
U16 is TryFrom {
  try_from = |val: U16| -> Result(U8, TryFromIntError) { crash "intrinsic: U16_try_into_U8" }
}
U16 is TryFrom {
  try_from = |val: U16| -> Result(I8, TryFromIntError) { crash "intrinsic: U16_try_into_I8" }
}
U16 is TryFrom {
  try_from = |val: U16| -> Result(I16, TryFromIntError) { crash "intrinsic: U16_try_into_I16" }
}
U16 is TryFrom {
  try_from = |val: U16| -> Result(F32, TryFromIntError) { crash "intrinsic: U16_try_into_F32" }
}

U16 is Debug {
    debug = |a: Self| -> Str { crash "intrinsic: U16_debug" }
}

U16 is Ord {
    compare = |a: Self, b: Self| -> Order {
        if a < b { Less } else if a == b { Equal } else { Greater }
    }
}

U16 is Hash {
    hash = |a: Self, h: Hasher| -> Hasher { crash "intrinsic: U16_hash" }
}

test "U16 traits" {
  expect 0 == 0
  expect 42 == 42
  expect not (0 == 1)
  expect 0 < 1
  expect 65535 > 0
  expect 42 <= 42
  expect 42 >= 42
  u16_val: U16 = 65535
  expect u16_val == 65535
}
