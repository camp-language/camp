// Num/F64.camp
// Operations on F64.

// Basic operations (abs is intrinsic due to sign bit handling)

pub abs = |n: F64| -> F64 { crash "intrinsic: Num.F64.abs" }

pub clamp = |lo: F64, hi: F64, n: F64| -> F64 { if n < lo { lo } else if n > hi { hi } else { n } }

pub max = |a: F64, b: F64| -> F64 { crash "intrinsic: Num.F64.max" }

pub min = |a: F64, b: F64| -> F64 { crash "intrinsic: Num.F64.min" }

pub neg = |n: F64| -> F64 { 0.0 - n }

// Rounding (intrinsic — needs libm)

pub ceiling = |n: F64| -> F64 { crash "intrinsic: Num.F64.ceiling" }

pub floor = |n: F64| -> F64 { crash "intrinsic: Num.F64.floor" }

pub round = |n: F64| -> F64 { crash "intrinsic: Num.F64.round" }

pub truncate = |n: F64| -> F64 { crash "intrinsic: Num.F64.truncate" }

// Classification (intrinsic — IEEE 754 bit inspection)

pub is_nan = |n: F64| -> Bool { crash "intrinsic: Num.F64.is_nan" }

pub is_infinite = |n: F64| -> Bool { crash "intrinsic: Num.F64.is_infinite" }

pub is_finite = |n: F64| -> Bool { crash "intrinsic: Num.F64.is_finite" }

// Constants

pub pi: F64 = 3.14159265358979323846

pub e: F64 = 2.71828182845904523536

pub nan: F64 = crash "intrinsic: Num.F64.nan"

pub infinity: F64 = crash "intrinsic: Num.F64.infinity"

pub neg_infinity: F64 = crash "intrinsic: Num.F64.neg_infinity"

// Trigonometry (intrinsic — needs libm)

pub sin = |n: F64| -> F64 { crash "intrinsic: Num.F64.sin" }

pub cos = |n: F64| -> F64 { crash "intrinsic: Num.F64.cos" }

pub tan = |n: F64| -> F64 { crash "intrinsic: Num.F64.tan" }

pub asin = |n: F64| -> F64 { crash "intrinsic: Num.F64.asin" }

pub acos = |n: F64| -> F64 { crash "intrinsic: Num.F64.acos" }

pub atan = |n: F64| -> F64 { crash "intrinsic: Num.F64.atan" }

pub atan2 = |y: F64, x: F64| -> F64 { crash "intrinsic: Num.F64.atan2" }

// Exponential/Logarithmic (intrinsic — needs libm)

pub exp = |n: F64| -> F64 { crash "intrinsic: Num.F64.exp" }

pub log = |n: F64| -> F64 { crash "intrinsic: Num.F64.log" }

pub log2 = |n: F64| -> F64 { crash "intrinsic: Num.F64.log2" }

pub log10 = |n: F64| -> F64 { crash "intrinsic: Num.F64.log10" }

// Power (intrinsic — needs libm)

pub pow = |base: F64, exp_val: F64| -> F64 { crash "intrinsic: Num.F64.pow" }

pub sqrt = |n: F64| -> F64 { crash "intrinsic: Num.F64.sqrt" }

// Conversion

pub to_str = |n: F64| -> Str { crash "intrinsic: Num.F64.to_str" }

pub from_str = |s: Str| -> F64 { crash "intrinsic: Num.F64.from_str" }

pub to_i64 = |n: F64| -> I64 { crash "intrinsic: Num.F64.to_i64" }

pub from_i64 = |n: I64| -> F64 { crash "intrinsic: Num.F64.from_i64" }
F64 is Eq {
    eq = |a: Self, b: Self| -> Bool { crash "intrinsic: F64_eq" }
}
F64 is Default {
  default = || -> F64 { crash "intrinsic: F64_default" }
}
F64 is TryFrom {
  try_from = |val: F64| -> Result(F32, TryFromIntError) { crash "intrinsic: F64_try_into_F32" }
}
F64 is TryFrom {
  try_from = |val: F64| -> Result(I64, TryFromIntError) { crash "intrinsic: F64_try_into_I64" }
}
F64 is TryFrom {
  try_from = |val: F64| -> Result(I32, TryFromIntError) { crash "intrinsic: F64_try_into_I32" }
}

F64 is Debug {
    debug = |a: Self| -> Str { crash "intrinsic: F64_debug" }
}

F64 is Ord {
    compare = |a: Self, b: Self| -> Order {
        if a < b { Less } else if a == b { Equal } else { Greater }
    }
}

F64 is Hash {
    hash = |a: Self, h: Hasher| -> Hasher { crash "intrinsic: F64_hash" }
}
