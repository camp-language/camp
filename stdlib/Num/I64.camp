// Num/I64.camp
// Operations on I64. Arithmetic operators are built into the language.

// Basic operations (pure Camp)

pub abs = |n: I64| -> I64 { if n < 0 { 0 - n } else { n } }

pub clamp = |lo: I64, hi: I64, n: I64| -> I64 { if n < lo { lo } else if n > hi { hi } else { n } }

pub max = |a: I64, b: I64| -> I64 { if a > b { a } else { b } }

pub min = |a: I64, b: I64| -> I64 { if a < b { a } else { b } }

pub neg = |n: I64| -> I64 { 0 - n }

// Checked arithmetic (intrinsic — overflow detection)

pub checked_add = |a: I64, b: I64| -> I64 { crash "intrinsic: Num.I64.checked_add" }

pub checked_sub = |a: I64, b: I64| -> I64 { crash "intrinsic: Num.I64.checked_sub" }

pub checked_mul = |a: I64, b: I64| -> I64 { crash "intrinsic: Num.I64.checked_mul" }

// Wrapping/saturating arithmetic (intrinsic)

pub wrapping_add = |a: I64, b: I64| -> I64 { crash "intrinsic: Num.I64.wrapping_add" }

pub saturating_add = |a: I64, b: I64| -> I64 { crash "intrinsic: Num.I64.saturating_add" }

pub saturating_sub = |a: I64, b: I64| -> I64 { crash "intrinsic: Num.I64.saturating_sub" }

// Conversion (intrinsic)

pub to_str = |n: I64| -> Str { crash "intrinsic: Num.I64.to_str" }

pub from_str = |s: Str| -> I64 { crash "intrinsic: Num.I64.from_str" }

// Range iteration (intrinsic — needs efficient generator)

pub range = |start: I64, end: I64| { crash "intrinsic: Num.I64.range" }

// Bitwise function wrappers (intrinsic)

pub bitwise_and = |a: I64, b: I64| -> I64 { crash "intrinsic: Num.I64.bitwise_and" }

pub bitwise_or = |a: I64, b: I64| -> I64 { crash "intrinsic: Num.I64.bitwise_or" }

pub bitwise_xor = |a: I64, b: I64| -> I64 { crash "intrinsic: Num.I64.bitwise_xor" }

pub bitwise_not = |a: I64| -> I64 { crash "intrinsic: Num.I64.bitwise_not" }

pub shift_left = |a: I64, n: I64| -> I64 { crash "intrinsic: Num.I64.shift_left" }

pub shift_right = |a: I64, n: I64| -> I64 { crash "intrinsic: Num.I64.shift_right" }

// Counting (intrinsic)

pub count_ones = |n: I64| -> I64 { crash "intrinsic: Num.I64.count_ones" }

pub count_zeros = |n: I64| -> I64 { crash "intrinsic: Num.I64.count_zeros" }

pub leading_zeros = |n: I64| -> I64 { crash "intrinsic: Num.I64.leading_zeros" }

pub trailing_zeros = |n: I64| -> I64 { crash "intrinsic: Num.I64.trailing_zeros" }
I64 is TryFrom {
  try_from = |val: I64| -> Result(I8, TryFromIntError) { crash "intrinsic: I64_try_into_I8" }
}
I64 is TryFrom {
  try_from = |val: I64| -> Result(I16, TryFromIntError) { crash "intrinsic: I64_try_into_I16" }
}
I64 is TryFrom {
  try_from = |val: I64| -> Result(I32, TryFromIntError) { crash "intrinsic: I64_try_into_I32" }
}
I64 is TryFrom {
  try_from = |val: I64| -> Result(U8, TryFromIntError) { crash "intrinsic: I64_try_into_U8" }
}
I64 is TryFrom {
  try_from = |val: I64| -> Result(U16, TryFromIntError) { crash "intrinsic: I64_try_into_U16" }
}
I64 is TryFrom {
  try_from = |val: I64| -> Result(U32, TryFromIntError) { crash "intrinsic: I64_try_into_U32" }
}
I64 is TryFrom {
  try_from = |val: I64| -> Result(U64, TryFromIntError) { crash "intrinsic: I64_try_into_U64" }
}
I64 is TryFrom {
  try_from = |val: I64| -> Result(F32, TryFromIntError) { crash "intrinsic: I64_try_into_F32" }
}