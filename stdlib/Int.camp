pub abs = |n: I64| -> I64 {
  if n < 0 { 0 - n } else { n }
}

pub clamp = |lo: I64, hi: I64, n: I64| -> I64 {
  if n < lo { lo } else if n > hi { hi } else { n }
}

pub max = |a: I64, b: I64| -> I64 {
  if a > b { a } else { b }
}

pub min = |a: I64, b: I64| -> I64 {
  if a < b { a } else { b }
}

