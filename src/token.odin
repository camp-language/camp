package camp

Token_Kind :: enum {
	Int_Literal,
	Float_Literal,
	String_Literal,

	Identifier,
	Upper_Id,

	Kw_If,
	Kw_Else,
	Kw_Match,
	Kw_Effect,
	Kw_Trait,
	Kw_Is,
	Kw_Alias,
	Kw_Handle,
	Kw_Intercept,
	Kw_In,
	Kw_With,
	Kw_Import,
	Kw_Exposing,
	Kw_As,
	Kw_Unsafe,
	Kw_For,
	Kw_And,
	Kw_Or,
	Kw_True,
	Kw_False,
	Kw_Expect,
	Kw_Test,
	Kw_Not,

	Pipe,
	Arrow,
	Fat_Arrow,
	Eq,
	Colon,
	Comma,
	Dot,
	Dot_Dot,
	Bang,
	Dollar,
	Hash,
	At,
	Lt,
	Gt,
	Lt_Eq,
	Gt_Eq,
	Eq_Eq,
	Bang_Eq,
	Plus,
	Minus,
	Star,
	Slash,
	Percent,
	Amp,
	Caret,
	Tilde,
	Backslash,

	LParen,
	RParen,
	LBrack,
	RBrack,
	LBrace,
	RBrace,

	Newline,
	Eof,
}

Token :: struct {
	kind:      Token_Kind,
	text:      string,
	span:      Source_Span,
	int_value: i64,
	f64_value: f64,
}
