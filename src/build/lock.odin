package build

import "camp:camp_toml"
import "core:fmt"
import "core:mem"
import "core:os"
import "core:path/filepath"
import "core:strings"

Lock_Entry :: struct {
	name:    string,
	source:  string,
	version: string,
	rev:     string,
	hash:    string,
}

Camp_Lock :: struct {
	packages: [dynamic]Lock_Entry,
}

lock_read :: proc(project_root: string, allocator: mem.Allocator) -> (Camp_Lock, bool) {
	lock: Camp_Lock
	lock.packages = make([dynamic]Lock_Entry, 0, 16, allocator)
	lock_path, _ := filepath.join({project_root, "camp.lock"}, allocator)
	defer delete(lock_path, allocator)
	data, read_err := os.read_entire_file(lock_path, allocator)
	if read_err != nil {return lock, false}
	defer delete(data, allocator)
	lock = lock_parse(string(data), allocator)
	return lock, true
}

lock_write :: proc(lock: Camp_Lock, project_root: string, allocator: mem.Allocator) {
	lock_path, _ := filepath.join({project_root, "camp.lock"}, allocator)
	defer delete(lock_path, allocator)
	b := strings.builder_make(allocator)
	defer strings.builder_destroy(&b)
	strings.write_string(&b, "# Auto-generated by camp. Do not edit.\n\n")
	for pkg in lock.packages {
		strings.write_string(&b, "[[packages]]\n")
		fmt.sbprintf(&b, "name = \"{}\"\n", pkg.name)
		fmt.sbprintf(&b, "source = \"{}\"\n", pkg.source)
		fmt.sbprintf(&b, "version = \"{}\"\n", pkg.version)
		fmt.sbprintf(&b, "rev = \"{}\"\n", pkg.rev)
		fmt.sbprintf(&b, "hash = \"sha256:{}\"\n", pkg.hash)
		strings.write_string(&b, "\n")
	}
	_ = os.write_entire_file(lock_path, transmute([]byte)strings.to_string(b))
}

lock_parse :: proc(input: string, allocator: mem.Allocator) -> Camp_Lock {
	lock: Camp_Lock
	lock.packages = make([dynamic]Lock_Entry, 0, 16, allocator)
	current: Lock_Entry
	in_package := false
	lines := strings.split_lines(input, allocator)
	for line_str in lines {
		trimmed := strings.trim_space(line_str)
		if len(trimmed) == 0 || trimmed[0] == '#' {continue}
		if strings.has_prefix(trimmed, "[[packages]]") {
			if in_package {append(&lock.packages, current); current = Lock_Entry{}}
			in_package = true
			continue
		}
		if !in_package {continue}
		eq := strings.index(trimmed, "=")
		if eq < 0 {continue}
		key := strings.trim_space(trimmed[:eq])
		val := _lock_unquote(strings.trim_space(trimmed[eq + 1:]))
		switch key {
		case "name":
			current.name = val
		case "source":
			current.source = val
		case "version":
			current.version = val
		case "rev":
			current.rev = val
		case "hash":
			if strings.has_prefix(
				val,
				"sha256:",
			) {current.hash = val[7:]} else {current.hash = val}
		}
	}
	if in_package {append(&lock.packages, current)}
	return lock
}

lock_find :: proc(lock: Camp_Lock, source: string) -> (Lock_Entry, bool) {
	for pkg in lock.packages {
		if pkg.source == source {return pkg, true}
	}
	return Lock_Entry{}, false
}

lock_check :: proc(lock: Camp_Lock, manifest: camp_toml.Camp_Toml) -> [dynamic]string {
	missing := make([dynamic]string, 0, 8, context.temp_allocator)
	for dep in manifest.dependencies {
		source, _ := parse_dep_uri(dep.uri)
		if _, ok := lock_find(lock, source); !ok {append(&missing, source)}
	}
	return missing
}

_lock_unquote :: proc(s: string) -> string {
	t := strings.trim_space(s)
	if len(t) >= 2 && t[0] == '"' && t[len(t) - 1] == '"' {return t[1:len(t) - 1]}
	return t
}

